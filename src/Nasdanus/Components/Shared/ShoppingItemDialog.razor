<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Class="shopping-item-dialog">
            <MudTextField T="string"
                          Label="Ingredient"
                          @bind-Value="_request.Name"
                          Required="true"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            <MudGrid Spacing="2">
                <MudItem xs="7">
                    <MudTextField T="string"
                                  Label="Quantitat"
                                  @bind-Value="_request.QuantityText"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="5">
                    <MudSelect T="string"
                               Label="Unitat"
                               @bind-Value="_request.Unit"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        @foreach (var unit in IngredientUnits.OptionsIncluding(_request.Unit))
                        {
                            <MudSelectItem T="string" Value="@unit.Value">@unit.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudSelect T="string"
                       Label="Categoria"
                       @bind-Value="_request.Category"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true">
                @foreach (var category in ShoppingCategory.DisplayOrder)
                {
                    <MudSelectItem T="string" Value="@category">@ShoppingCategory.ToDisplayName(category)</MudSelectItem>
                }
            </MudSelect>

            <MudCheckBox T="bool"
                         Label="Item general de la llar"
                         @bind-Value="_request.IsHouseholdItem"
                         Color="Color.Primary" />

            @if (!_request.IsHouseholdItem)
            {
                <MudSelect T="int?"
                           Label="Recepta vinculada (opcional)"
                           @bind-Value="_request.RecipeId"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="int?" Value="@NoRecipe">Sense recepta vinculada</MudSelectItem>
                    @foreach (var recipe in Recipes)
                    {
                        <MudSelectItem T="int?" Value="@recipe.Id">@recipe.Name</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel·lar</MudButton>
        <MudButton OnClick="Save"
                   Disabled="@string.IsNullOrWhiteSpace(_request.Name)"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public ShoppingListItem? Item { get; set; }

    [Parameter]
    public IReadOnlyList<Recipe> Recipes { get; set; } = [];

    private readonly ShoppingItemEditRequest _request = new();
    private static int? NoRecipe => null;

    protected override void OnParametersSet()
    {
        if (Item is null)
        {
            _request.Category = ShoppingCategory.Other;
            return;
        }

        _request.Name = Item.Name;
        _request.Category = Item.Category;
        _request.QuantityText = Item.QuantityText;
        _request.Unit = IngredientUnits.Normalize(Item.Unit);
        _request.IsHouseholdItem = Item.IsHouseholdItem;
        _request.RecipeId = Item.RecipeId;
    }

    private void Save()
    {
        _request.Unit = IngredientUnits.Normalize(_request.Unit);
        MudDialog.Close(DialogResult.Ok(_request));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
