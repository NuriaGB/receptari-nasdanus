@page "/planner"
@using System.Globalization
@inject PlannerService Planner
@inject RecipeService Recipes
@inject PlanningSettingsService PlanningSettings
@inject RecipeSuggestionService Suggestions
@inject IJSRuntime JS

<PageTitle>Nasdanus - Planner</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="page-shell planner-shell">
    <MudStack Spacing="3">
        <div class="page-heading planner-heading">
            <div>
                <MudText Typo="Typo.overline">Planner</MudText>
                <MudText Typo="Typo.h3">Setmana @WeekNumber</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@WeekRangeText</MudText>
            </div>
            <MudStack Row Spacing="1" Class="planner-week-nav">
                <MudButton OnClick="PreviousWeekAsync"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ChevronLeft">
                    Setmana anterior
                </MudButton>
                <MudButton OnClick="NextWeekAsync"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ChevronRight">
                    Setmana següent
                </MudButton>
                <MudButton OnClick="PrintAsync"
                           Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Print">
                    Imprimir
                </MudButton>
            </MudStack>
        </div>

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <section class="recipe-ideas-section" aria-labelledby="recipe-ideas-title">
                <div class="recipe-ideas-header">
                    <div>
                        <MudText Typo="Typo.h5" id="recipe-ideas-title">Idees de receptes</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@RecipeIdeas.Count disponibles</MudText>
                    </div>
                    @if (IsRecipeIdeaBrowseActive)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                            @VisibleRecipeIdeas.Count / @FilteredRecipeIdeas.Count visibles
                        </MudChip>
                    }
                </div>

                @if (RecipeIdeas.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No hi ha idees de recepta disponibles amb els filtres actuals.</MudText>
                }
                else
                {
                    <div class="recipe-ideas-tools">
                        <MudTextField T="string"
                                      @bind-Value="_recipeIdeaSearch"
                                      Immediate="true"
                                      Placeholder="Cerca recepta"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                        <MudSelect T="string"
                                   @bind-Value="_recipeIdeaCategory"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Category">
                            <MudSelectItem T="string" Value="@string.Empty">Totes les categories</MudSelectItem>
                            @foreach (var category in RecipeIdeaCategories)
                            {
                                <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton OnClick="ToggleAllRecipeIdeas"
                                   Variant="@(_showAllRecipeIdeas ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ViewList">
                            Mostrar totes
                        </MudButton>
                        <MudIconButton OnClick="ClearRecipeIdeaFilters"
                                       Disabled="@(!IsRecipeIdeaBrowseActive)"
                                       Icon="@Icons.Material.Filled.FilterAltOff"
                                       Color="Color.Secondary"
                                       aria-label="Netejar filtres" />
                    </div>

                    <div class="recipe-idea-categories" role="group" aria-label="Categories suggerides">
                        @foreach (var category in RecipeIdeaCategorySummaries.Take(12))
                        {
                            <MudButton OnClick="@(() => SelectRecipeIdeaCategory(category.Name))"
                                       Variant="@RecipeIdeaCategoryVariant(category.Name)"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Category">
                                @category.Name (@category.Count)
                            </MudButton>
                        }
                    </div>

                    @if (IsRecipeIdeaBrowseActive)
                    {
                        @if (FilteredRecipeIdeas.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No hi ha receptes amb aquests filtres.</MudAlert>
                        }
                        else
                        {
                            <div class="recipe-ideas-list">
                                @foreach (var recipe in VisibleRecipeIdeas)
                                {
                                    <div class="recipe-idea-chip"
                                         draggable="true"
                                         @ondragstart="@(() => BeginRecipeIdeaDrag(recipe.Id))"
                                         @ondragend="EndRecipeIdeaDrag">
                                        <div class="recipe-idea-main">
                                            <span class="recipe-idea-name" title="@recipe.Name">@recipe.Name</span>
                                            <span class="recipe-idea-meta">@RecipeIdeaMetaText(recipe)</span>
                                        </div>
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                                 Size="Size.Small"
                                                 Dense="true"
                                                 Color="Color.Primary"
                                                 AriaLabel="Assignar idea">
                                            @foreach (var day in _days)
                                            {
                                                <MudMenuItem OnClick="@(() => AssignRecipeIdeaAsync(recipe.Id, day.Date, MealKind.Breakfast))">
                                                    @FormatDay(day.Date) esmorzar
                                                </MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AssignRecipeIdeaAsync(recipe.Id, day.Date, MealKind.Lunch))">
                                                    @FormatDay(day.Date) dinar
                                                </MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AssignRecipeIdeaAsync(recipe.Id, day.Date, MealKind.Dinner))">
                                                    @FormatDay(day.Date) sopar
                                                </MudMenuItem>
                                            }
                                        </MudMenu>
                                        <MudIconButton OnClick="@(() => DismissRecipeIdeaAsync(recipe.Id))"
                                                       Icon="@Icons.Material.Filled.Close"
                                                       Color="Color.Secondary"
                                                       Size="Size.Small"
                                                       aria-label="Treure idea" />
                                    </div>
                                }
                            </div>
                        }
                    }
                }
            </section>

            <div class="planner-grid" role="list">
                @foreach (var day in _days)
                {
                    var dayTotals = DayNutritionTotals(day);
                    var dayGoal = DailyGoal(dayTotals);

                    <MudPaper Class="planner-day-card" Elevation="0" role="listitem">
                        <div class="planner-day-header">
                            <MudText Typo="Typo.subtitle1">@FormatDay(day.Date)</MudText>
                            @if (day.Date == _today)
                            {
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Avui</MudChip>
                            }
                        </div>

                        <MealSlotSelector Slot="@day.Breakfast"
                                          Recipes="_recipes"
                                          AddRecipe="AddRecipeAsync"
                                          RemoveRecipe="RemoveRecipeAsync"
                                          ReplaceRecipe="ReplaceRecipeAsync"
                                          UpdateServings="UpdatePlannedServingsAsync"
                                          DraggedRecipeId="_draggedRecipeIdeaId"
                                          DraggedPlannedRecipeId="_draggedPlannedRecipeId"
                                          RecipeDropped="DropRecipeIdeaAsync"
                                          PlannedRecipeDragStarted="BeginPlannedRecipeDrag"
                                          PlannedRecipeDragEnded="EndPlannedRecipeDrag"
                                          PlannedRecipeDropped="DropPlannedRecipeAsync" />
                        <MealSlotSelector Slot="@day.Lunch"
                                          Recipes="_recipes"
                                          AddRecipe="AddRecipeAsync"
                                          RemoveRecipe="RemoveRecipeAsync"
                                          ReplaceRecipe="ReplaceRecipeAsync"
                                          UpdateServings="UpdatePlannedServingsAsync"
                                          DraggedRecipeId="_draggedRecipeIdeaId"
                                          DraggedPlannedRecipeId="_draggedPlannedRecipeId"
                                          RecipeDropped="DropRecipeIdeaAsync"
                                          PlannedRecipeDragStarted="BeginPlannedRecipeDrag"
                                          PlannedRecipeDragEnded="EndPlannedRecipeDrag"
                                          PlannedRecipeDropped="DropPlannedRecipeAsync" />
                        <MealSlotSelector Slot="@day.Dinner"
                                          Recipes="_recipes"
                                          AddRecipe="AddRecipeAsync"
                                          RemoveRecipe="RemoveRecipeAsync"
                                          ReplaceRecipe="ReplaceRecipeAsync"
                                          UpdateServings="UpdatePlannedServingsAsync"
                                          DraggedRecipeId="_draggedRecipeIdeaId"
                                          DraggedPlannedRecipeId="_draggedPlannedRecipeId"
                                          RecipeDropped="DropRecipeIdeaAsync"
                                          PlannedRecipeDragStarted="BeginPlannedRecipeDrag"
                                          PlannedRecipeDragEnded="EndPlannedRecipeDrag"
                                          PlannedRecipeDropped="DropPlannedRecipeAsync" />
                        <NutritionSummary Title="Total dia"
                                          Subtitle="Per racio - esmorzar + dinar + sopar"
                                          Totals="@dayTotals"
                                          Dense="true"
                                          MissingDataHref="nutrition-gaps?view=planned" />
                        <MudPaper Class="@DailyGoalCardClass(dayGoal)" Elevation="0">
                            <MudIcon Icon="@DailyGoalIcon(dayGoal)"
                                     Color="@DailyGoalColor(dayGoal)"
                                     Size="Size.Small" />
                            <div class="daily-goal-copy">
                                <MudText Typo="Typo.subtitle2">@DailyGoalTitle(dayGoal)</MudText>
                                <div class="daily-goal-lines">
                                    <span>Proteina @FormatGoalNumber(dayGoal.ProteinGrams) g (@FormatGoalNumber(dayGoal.ProteinPercent)% de @FormatGoalNumber(dayGoal.ProteinTargetGrams) g)</span>
                                    <span>Kcal @FormatGoalNumber(dayGoal.CaloriesKcal) / @FormatGoalNumber(dayGoal.CalorieLimit)</span>
                                </div>
                            </div>
                        </MudPaper>
                    </MudPaper>
                }
            </div>

            <section class="planner-print-sheet" aria-label="Planning setmanal imprimible">
                <header class="planner-print-header">
                    <div>
                        <p class="planner-print-kicker">Nasdanus</p>
                        <h1>Planning setmanal</h1>
                    </div>
                    <div class="planner-print-meta">
                        <span>Setmana @WeekNumber</span>
                        <strong>@WeekRangeText</strong>
                    </div>
                </header>

                <div class="planner-print-grid">
                    @foreach (var day in _days)
                    {
                        <article class="planner-print-card planner-print-day">
                            <header class="planner-print-card-header">
                                <span>@FormatPrintDayName(day.Date)</span>
                                <small>@FormatPrintDate(day.Date)</small>
                            </header>
                            @PrintMealSection("Esmorzar", day.Breakfast)
                            @PrintMealSection("Dinar", day.Lunch)
                            @PrintMealSection("Sopar", day.Dinner)
                            @PrintMealSection("Snacks", null)
                        </article>
                    }

                    <article class="planner-print-card planner-print-notes">
                        <header class="planner-print-card-header">
                            <span>Resum setmanal</span>
                            <small>Per persona</small>
                        </header>
                        <div class="planner-print-notes-body planner-print-nutrition">
                            <table class="planner-print-nutrition-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Dia</th>
                                        <th scope="col">Kcal</th>
                                        <th scope="col">Prot. g</th>
                                        <th scope="col">HC g</th>
                                        <th scope="col">Greix g</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var day in _days)
                                    {
                                        var totals = DayNutritionTotals(day);
                                        <tr>
                                            <th scope="row">@FormatPrintNutritionDay(day.Date)</th>
                                            <td>@FormatPrintNutritionNumber(totals.CaloriesKcal)</td>
                                            <td>@FormatPrintNutritionNumber(totals.ProteinGrams)</td>
                                            <td>@FormatPrintNutritionNumber(totals.CarbohydrateGrams)</td>
                                            <td>@FormatPrintNutritionNumber(totals.FatGrams)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    @{
                                        var weekTotals = WeekNutritionTotals(_days);
                                    }
                                    <tr>
                                        <th scope="row">Setmana</th>
                                        <td>@FormatPrintNutritionNumber(weekTotals.CaloriesKcal)</td>
                                        <td>@FormatPrintNutritionNumber(weekTotals.ProteinGrams)</td>
                                        <td>@FormatPrintNutritionNumber(weekTotals.CarbohydrateGrams)</td>
                                        <td>@FormatPrintNutritionNumber(weekTotals.FatGrams)</td>
                                    </tr>
                                </tfoot>
                            </table>
                            @if (WeekHasMissingNutritionData(_days))
                            {
                                <p class="planner-print-nutrition-note">Hi ha ingredients amb dades nutricionals pendents.</p>
                            }
                            @if (PrintFoodRuleStatuses.Count > 0)
                            {
                                <div class="planner-print-food-rules">
                                    <p class="@PrintFoodRulesSummaryClass">
                                        Regles de categories: @PrintFoodRulesSummaryText
                                    </p>
                                    <div class="planner-print-food-rule-list">
                                        @foreach (var rule in PrintFoodRuleStatuses)
                                        {
                                            <div class="@PrintFoodRuleClass(rule)">
                                                <span class="planner-print-food-rule-state">@PrintFoodRuleState(rule)</span>
                                                <span class="planner-print-food-rule-name">@FoodGroupKind.ToDisplayName(rule.FoodGroup)</span>
                                                <span class="planner-print-food-rule-progress">@PrintFoodRuleProgress(rule)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                </div>
            </section>
        }
    </MudStack>
</MudContainer>

@code {
    private static readonly string[] CatalanShortDayNames = ["dg.", "dl.", "dt.", "dc.", "dj.", "dv.", "ds."];
    private static readonly string[] CatalanDayNames = ["Diumenge", "Dilluns", "Dimarts", "Dimecres", "Dijous", "Divendres", "Dissabte"];

    private DateOnly _today;
    private DateOnly _weekStart;
    private List<DayPlan> _days = [];
    private List<Recipe> _recipes = [];
    private HouseholdPlanningSettings? _settings;
    private Dictionary<int, int> _plannedRecipeCounts = [];
    private WeeklyNutritionGoalStatus? _weekStatus;
    private HashSet<int> _dismissedRecipeIdeaIds = [];
    private string _recipeIdeaSearch = string.Empty;
    private string _recipeIdeaCategory = string.Empty;
    private bool _showAllRecipeIdeas;
    private int? _draggedRecipeIdeaId;
    private int? _draggedPlannedRecipeId;
    private bool _isLoading = true;

    private const string NoCategoryLabel = "Sense categoria";

    private int WeekNumber => ISOWeek.GetWeekOfYear(_weekStart.ToDateTime(TimeOnly.MinValue));
    private string WeekRangeText => $"{_weekStart.ToString("d/M", CultureInfo.InvariantCulture)} - {_weekStart.AddDays(6).ToString("d/M/yyyy", CultureInfo.InvariantCulture)}";
    private decimal ProteinTargetGrams => PositiveOrDefault(_settings?.NutritionGoals.MinimumProteinGramsPerPerson, 150m);
    private decimal CalorieLimit => PositiveOrDefault(_settings?.NutritionGoals.TargetCaloriesPerPerson, 2000m);
    private IReadOnlyList<Recipe> RecipeIdeas => _recipes
        .Where(recipe => !_dismissedRecipeIdeaIds.Contains(recipe.Id))
        .OrderBy(recipe => PlannedRecipeCount(recipe.Id))
        .ThenBy(recipe => recipe.Name)
        .ToList();
    private IReadOnlyList<FoodGroupTargetStatus> PrintFoodRuleStatuses =>
        _weekStatus?.FoodGroupTargets ?? [];
    private bool ArePrintFoodRulesMet =>
        PrintFoodRuleStatuses.Count > 0
        && PrintFoodRuleStatuses.All(IsFoodRuleMet);
    private string PrintFoodRulesSummaryClass =>
        ArePrintFoodRulesMet
            ? "planner-print-food-rules-summary is-ok"
            : "planner-print-food-rules-summary is-warning";
    private string PrintFoodRulesSummaryText =>
        ArePrintFoodRulesMet ? "totes complertes" : "pendents de revisar";
    private bool IsRecipeIdeaBrowseActive =>
        _showAllRecipeIdeas
        || !string.IsNullOrWhiteSpace(_recipeIdeaSearch)
        || !string.IsNullOrWhiteSpace(_recipeIdeaCategory);
    private IReadOnlyList<RecipeIdeaCategorySummary> RecipeIdeaCategorySummaries => RecipeIdeas
        .SelectMany(recipe => RecipeIdeaCategoriesFor(recipe).Select(category => (Category: category, RecipeId: recipe.Id)))
        .GroupBy(item => item.Category, StringComparer.OrdinalIgnoreCase)
        .Select(group => new RecipeIdeaCategorySummary(group.Key, group.Select(item => item.RecipeId).Distinct().Count()))
        .OrderByDescending(category => category.Count)
        .ThenBy(category => category.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private IReadOnlyList<string> RecipeIdeaCategories => RecipeIdeaCategorySummaries
        .Select(category => category.Name)
        .ToList();
    private IReadOnlyList<Recipe> FilteredRecipeIdeas => RecipeIdeas
        .Where(MatchesRecipeIdeaFilters)
        .OrderBy(recipe => PlannedRecipeCount(recipe.Id))
        .ThenBy(recipe => recipe.Name)
        .ToList();
    private IReadOnlyList<Recipe> VisibleRecipeIdeas => FilteredRecipeIdeas
        .Take(60)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        _today = DateOnly.FromDateTime(DateTime.Today);
        _weekStart = PlannerService.WeekStart(_today);
        _settings = await PlanningSettings.GetSettingsAsync();
        _recipes = await Recipes.GetAllAsync();
        await LoadWeekAsync();
        _isLoading = false;
    }

    private async Task LoadWeekAsync()
    {
        _days = await Planner.GetWeekAsync(_weekStart);
        _plannedRecipeCounts = _days
            .SelectMany(day => DaySlots(day).SelectMany(slot => slot.PlannedRecipes))
            .GroupBy(plannedRecipe => plannedRecipe.RecipeId)
            .ToDictionary(group => group.Key, group => group.Count());
        _weekStatus = await Suggestions.GetWeekStatusAsync(_weekStart);
        _dismissedRecipeIdeaIds = await Planner.GetDismissedRecipeIdeaIdsAsync(_weekStart);
    }

    private async Task AddRecipeAsync((DateOnly Date, MealKind MealKind, PlannedRecipeSelection Selection) change)
    {
        await Planner.AddRecipeAsync(change.Date, change.MealKind, change.Selection.RecipeId, change.Selection.PlannedServings);
        _recipes = await Recipes.GetAllAsync();
        await LoadWeekAsync();
    }

    private async Task RemoveRecipeAsync(int plannedRecipeId)
    {
        await Planner.RemoveRecipeAsync(plannedRecipeId);
        await LoadWeekAsync();
    }

    private async Task ReplaceRecipeAsync((int PlannedRecipeId, PlannedRecipeSelection Selection) change)
    {
        await Planner.ReplaceRecipeAsync(change.PlannedRecipeId, change.Selection.RecipeId, change.Selection.PlannedServings);
        await LoadWeekAsync();
    }

    private async Task UpdatePlannedServingsAsync((int PlannedRecipeId, int PlannedServings) change)
    {
        await Planner.UpdatePlannedServingsAsync(change.PlannedRecipeId, change.PlannedServings);
        await LoadWeekAsync();
    }

    private async Task DropPlannedRecipeAsync((int PlannedRecipeId, DateOnly Date, MealKind MealKind) target)
    {
        await Planner.MoveRecipeAsync(target.PlannedRecipeId, target.Date, target.MealKind);
        await LoadWeekAsync();
        _draggedPlannedRecipeId = null;
    }

    private async Task AssignRecipeIdeaAsync(int recipeId, DateOnly date, MealKind mealKind)
    {
        var recipe = _recipes.FirstOrDefault(recipe => recipe.Id == recipeId);
        if (recipe is null)
        {
            return;
        }

        var servings = recipe.Servings > 0 ? recipe.Servings : 3;
        await Planner.AddRecipeAsync(date, mealKind, recipe.Id, servings);
        _recipes = await Recipes.GetAllAsync();
        await LoadWeekAsync();
        _draggedRecipeIdeaId = null;
    }

    private async Task DropRecipeIdeaAsync((DateOnly Date, MealKind MealKind) target)
    {
        if (_draggedRecipeIdeaId is int recipeId)
        {
            await AssignRecipeIdeaAsync(recipeId, target.Date, target.MealKind);
        }
    }

    private async Task DismissRecipeIdeaAsync(int recipeId)
    {
        await Planner.DismissRecipeIdeaAsync(_weekStart, recipeId);
        _dismissedRecipeIdeaIds = await Planner.GetDismissedRecipeIdeaIdsAsync(_weekStart);
    }

    private async Task PreviousWeekAsync()
    {
        _weekStart = _weekStart.AddDays(-7);
        await LoadWeekAsync();
    }

    private async Task NextWeekAsync()
    {
        _weekStart = _weekStart.AddDays(7);
        await LoadWeekAsync();
    }

    private async Task PrintAsync()
    {
        await JS.InvokeVoidAsync("print");
    }

    private static string FormatDay(DateOnly date) =>
        $"{CatalanShortDayNames[(int)date.DayOfWeek]} {date.ToString("d/M", CultureInfo.InvariantCulture)}";

    private static string FormatPrintDayName(DateOnly date) =>
        CatalanDayNames[(int)date.DayOfWeek];

    private static string FormatPrintDate(DateOnly date) =>
        date.ToString("d/M", CultureInfo.InvariantCulture);

    private static string FormatPrintNutritionDay(DateOnly date) =>
        $"{CatalanShortDayNames[(int)date.DayOfWeek].TrimEnd('.')} {date.ToString("d/M", CultureInfo.InvariantCulture)}";

    private static IReadOnlyList<MealPlanRecipe> PrintPlannedRecipes(MealPlanSlot? slot) =>
        slot?.PlannedRecipes
            .OrderBy(plannedRecipe => plannedRecipe.Order)
            .ToList()
        ?? [];

    private static string PrintPlannedRecipeText(MealPlanRecipe plannedRecipe)
    {
        var name = plannedRecipe.Recipe?.Name;
        var servings = plannedRecipe.PlannedServings > 0
            ? plannedRecipe.PlannedServings
            : plannedRecipe.Recipe?.Servings > 0
                ? plannedRecipe.Recipe.Servings
                : 3;

        return $"{(string.IsNullOrWhiteSpace(name) ? "Recepta sense nom" : name)} - {servings} racions";
    }

    private RenderFragment PrintMealSection(string label, MealPlanSlot? slot) => @<section class="planner-print-meal">
        <h2>@label</h2>
        @if (PrintPlannedRecipes(slot).Count == 0)
        {
            <div class="planner-print-empty-line"></div>
        }
        else
        {
            <ul>
                @foreach (var plannedRecipe in PrintPlannedRecipes(slot))
                {
                    <li>@PrintPlannedRecipeText(plannedRecipe)</li>
                }
            </ul>
        }
    </section>;

    private void SelectRecipeIdeaCategory(string category)
    {
        _recipeIdeaCategory = category;
        _showAllRecipeIdeas = false;
    }

    private void ToggleAllRecipeIdeas()
    {
        _showAllRecipeIdeas = !_showAllRecipeIdeas;
        if (_showAllRecipeIdeas)
        {
            _recipeIdeaSearch = string.Empty;
            _recipeIdeaCategory = string.Empty;
        }
    }

    private void ClearRecipeIdeaFilters()
    {
        _recipeIdeaSearch = string.Empty;
        _recipeIdeaCategory = string.Empty;
        _showAllRecipeIdeas = false;
    }

    private void BeginRecipeIdeaDrag(int recipeId)
    {
        _draggedRecipeIdeaId = recipeId;
        _draggedPlannedRecipeId = null;
    }

    private void EndRecipeIdeaDrag()
    {
        _draggedRecipeIdeaId = null;
    }

    private void BeginPlannedRecipeDrag(int plannedRecipeId)
    {
        _draggedPlannedRecipeId = plannedRecipeId;
        _draggedRecipeIdeaId = null;
    }

    private void EndPlannedRecipeDrag()
    {
        _draggedPlannedRecipeId = null;
    }

    private Variant RecipeIdeaCategoryVariant(string category) =>
        string.Equals(_recipeIdeaCategory, category, StringComparison.OrdinalIgnoreCase)
            ? Variant.Filled
            : Variant.Outlined;

    private bool MatchesRecipeIdeaFilters(Recipe recipe)
    {
        if (!string.IsNullOrWhiteSpace(_recipeIdeaCategory)
            && !RecipeIdeaCategoriesFor(recipe).Contains(_recipeIdeaCategory, StringComparer.OrdinalIgnoreCase))
        {
            return false;
        }

        return string.IsNullOrWhiteSpace(_recipeIdeaSearch)
            || RecipeLibraryAnalysis.MatchesSearch(recipe, _recipeIdeaSearch);
    }

    private static IReadOnlyList<string> RecipeIdeaCategoriesFor(Recipe recipe)
    {
        var categories = RecipeCategory.Parse(recipe.Category);
        return categories.Count == 0 ? [NoCategoryLabel] : categories;
    }

    private static string RecipeIdeaCategoryText(Recipe recipe) =>
        string.Join(", ", RecipeIdeaCategoriesFor(recipe));

    private string RecipeIdeaMetaText(Recipe recipe)
    {
        var count = PlannedRecipeCount(recipe.Id);
        if (count == 0)
        {
            return RecipeIdeaCategoryText(recipe);
        }

        var repeatedText = count == 1
            ? "1 cop aquesta setmana"
            : $"{count} cops aquesta setmana";
        return $"{RecipeIdeaCategoryText(recipe)} - {repeatedText}";
    }

    private int PlannedRecipeCount(int recipeId) =>
        _plannedRecipeCounts.TryGetValue(recipeId, out var count) ? count : 0;

    private static NutritionTotals DayNutritionTotals(DayPlan day)
    {
        var totals = new NutritionTotals();
        foreach (var slot in DaySlots(day))
        {
            totals.Add(NutritionService.PerPersonMeal(NutritionService.CalculateMeal(slot)));
        }

        return totals;
    }

    private static NutritionTotals WeekNutritionTotals(IEnumerable<DayPlan> days)
    {
        var totals = new NutritionTotals();
        foreach (var day in days)
        {
            totals.Add(DayNutritionTotals(day));
        }

        return totals;
    }

    private static bool WeekHasMissingNutritionData(IEnumerable<DayPlan> days) =>
        days.Any(day => DayNutritionTotals(day).HasMissingData);

    private static bool IsFoodRuleMet(FoodGroupTargetStatus rule) =>
        rule.Target <= 0
        || (rule.IsMaximum
            ? rule.Current <= rule.Target
            : rule.Current >= rule.Target);

    private static string PrintFoodRuleClass(FoodGroupTargetStatus rule) =>
        IsFoodRuleMet(rule)
            ? "planner-print-food-rule is-ok"
            : "planner-print-food-rule is-warning";

    private static string PrintFoodRuleState(FoodGroupTargetStatus rule) =>
        IsFoodRuleMet(rule) ? "OK" : "Pendent";

    private static string PrintFoodRuleProgress(FoodGroupTargetStatus rule) =>
        rule.IsMaximum
            ? $"{rule.Current} / max {rule.Target}"
            : $"{rule.Current} / {rule.Target}";

    private static MealPlanSlot[] DaySlots(DayPlan day) =>
    [
        day.Breakfast,
        day.Lunch,
        day.Dinner
    ];

    private DailyNutritionGoal DailyGoal(NutritionTotals totals)
    {
        var proteinTarget = ProteinTargetGrams;
        var calorieLimit = CalorieLimit;
        var proteinPercent = proteinTarget > 0 ? totals.ProteinGrams * 100m / proteinTarget : 0m;
        var proteinInRange = proteinPercent is >= 80m and <= 110m;
        var caloriesInRange = totals.CaloriesKcal <= calorieLimit;

        return new DailyNutritionGoal(
            totals.CaloriesKcal,
            totals.ProteinGrams,
            proteinTarget,
            proteinPercent,
            calorieLimit,
            proteinInRange,
            caloriesInRange);
    }

    private static decimal PositiveOrDefault(decimal? value, decimal fallback) =>
        value is > 0 ? value.Value : fallback;

    private static string DailyGoalCardClass(DailyNutritionGoal goal) =>
        goal.IsOnTrack ? "daily-goal-card is-ok" : "daily-goal-card is-warning";

    private static string DailyGoalIcon(DailyNutritionGoal goal) =>
        goal.IsOnTrack ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Info;

    private static Color DailyGoalColor(DailyNutritionGoal goal) =>
        goal.IsOnTrack ? Color.Success : Color.Warning;

    private static string DailyGoalTitle(DailyNutritionGoal goal) =>
        goal.IsOnTrack
            ? "Objectiu del dia OK"
            : "Revisa objectiu del dia";

    private static string FormatGoalNumber(decimal value) =>
        Math.Round(value, 0).ToString("0", CultureInfo.InvariantCulture);

    private static string FormatPrintNutritionNumber(decimal value) =>
        Math.Round(value, 0).ToString("0", CultureInfo.InvariantCulture);

    private sealed record RecipeIdeaCategorySummary(string Name, int Count);

    private sealed record DailyNutritionGoal(
        decimal CaloriesKcal,
        decimal ProteinGrams,
        decimal ProteinTargetGrams,
        decimal ProteinPercent,
        decimal CalorieLimit,
        bool ProteinInRange,
        bool CaloriesInRange)
    {
        public bool IsOnTrack => ProteinInRange && CaloriesInRange;
    }
}
