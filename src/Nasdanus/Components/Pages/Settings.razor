@page "/settings"
@using System.Globalization
@inject PlanningSettingsService PlanningSettings
@inject HouseholdIngredientPreferenceService Preferences
@inject BrowserAppStore Store
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Nasdanus - Configuracio</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="page-shell settings-shell">
    <MudStack Spacing="3">
        <div class="page-heading page-heading-actions">
            <div>
                <MudText Typo="Typo.overline">Configuracio</MudText>
                <MudText Typo="Typo.h3">La manera de menjar de casa</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Objectius, preferencies i criteris que guien el planner i les recomanacions.
                </MudText>
            </div>
            <MudStack Row Spacing="1" Class="settings-actions">
                <MudButton OnClick="SaveSettingsAsync"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_isLoading || _isSavingSettings)">
                    Desar configuracio
                </MudButton>
                <MudButton OnClick="SaveAllIngredientsAsync"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Inventory2"
                           Disabled="@(_isLoading || _isSavingIngredients)">
                    Desar ingredients
                </MudButton>
            </MudStack>
        </div>

        @if (_isLoading || _settings is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudTabs Rounded="true" Elevation="0" Class="settings-tabs">
                <MudTabPanel Text="General">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("General", "Valors per defecte de la llar. Les racions son nomes el punt de partida habitual i es poden canviar al Planner i al mode de cuina.")
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="Nom de la llar" @bind-Value="_settings.General.HouseholdName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2">
                                <MudSelect T="string" Label="Idioma" @bind-Value="_settings.General.DefaultLanguage" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var language in HouseholdLanguage.All)
                                    {
                                        <MudSelectItem T="string" Value="@language">@HouseholdLanguage.ToDisplayName(language)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2">
                                <MudSelect T="string" Label="Mesura" @bind-Value="_settings.General.MeasurementSystem" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var system in MeasurementSystemKind.All)
                                    {
                                        <MudSelectItem T="string" Value="@system">@MeasurementSystemKind.ToDisplayName(system)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2">
                                <MudNumericField T="int" Label="Racions per defecte de casa" @bind-Value="_settings.General.DefaultServings" Min="1" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2">
                                <MudSelect T="DayOfWeek" Label="Inici setmana" @bind-Value="_settings.General.WeekStartsOn" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var day in OrderedDays)
                                    {
                                        <MudSelectItem T="DayOfWeek" Value="@day">@DisplayDay(day)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Household Members">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("Household Members", "Perfils informatius per personalitzar suggeriments. No son dades mediques ni prescriuen dietes.")
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            Aquests perfils ajudaran el motor de nutricio i suggeriments a entendre la composicio de la llar, activitat, gustos i consideracions generals.
                        </MudAlert>
                        <MudButton OnClick="AddMember"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">
                            Afegir membre
                        </MudButton>

                        <div class="member-profile-list">
                            @foreach (var member in _settings.Members)
                            {
                                <MudPaper Class="member-profile-card" Elevation="0">
                                    <div class="member-profile-header">
                                        <div>
                                            <MudText Typo="Typo.h6">@MemberTitle(member)</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@AgeText(member)</MudText>
                                        </div>
                                        <MudIconButton OnClick="@(() => RemoveMember(member))"
                                                       Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Secondary"
                                                       aria-label="Eliminar membre" />
                                    </div>

                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="3">
                                            <MudTextField T="string" Label="Nom" @bind-Value="member.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudDatePicker Label="Data naixement"
                                                           Date="@member.DateOfBirth"
                                                           DateChanged="@((DateTime? value) => member.DateOfBirth = value)"
                                                           DateFormat="dd/MM/yyyy"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3" md="2">
                                            <MudNumericField T="decimal" Label="Alcada cm" @bind-Value="member.HeightCentimeters" Min="0" Max="260" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3" md="2">
                                            <MudNumericField T="decimal" Label="Pes kg" @bind-Value="member.WeightKilograms" Min="0" Max="400" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3" md="2">
                                            <MudNumericField T="decimal?" Label="Greix corporal % opcional" @bind-Value="member.BodyFatPercentage" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudDatePicker Label="Data mesura"
                                                           Date="@member.MeasurementDate"
                                                           DateChanged="@((DateTime? value) => member.MeasurementDate = value)"
                                                           DateFormat="dd/MM/yyyy"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudSelect T="string" Label="Sexe" @bind-Value="member.Sex" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                @foreach (var sex in MemberSex.All)
                                                {
                                                    <MudSelectItem T="string" Value="@sex">@MemberSex.ToDisplayName(sex)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string" Label="Etapa vital" @bind-Value="member.CurrentLifeStage" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudSelect T="string" Label="Activitat" @bind-Value="member.ActivityLevel" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                @foreach (var level in MemberActivityLevel.All)
                                                {
                                                    <MudSelectItem T="string" Value="@level">@MemberActivityLevel.ToDisplayName(level)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="5">
                                            <MudTextField T="string" Label="Exercici setmanal" @bind-Value="member.WeeklyExercise" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string" Label="Ocupacio opcional" @bind-Value="member.Occupation" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" md="8">
                                            <MudTextField T="string" Label="Notes de salut informatives" @bind-Value="member.HealthNotes" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string" Label="Menjars preferits" @bind-Value="member.FavouriteFoods" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string" Label="Evitar" @bind-Value="member.FoodsToAvoid" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string" Label="Fomentar" @bind-Value="member.FoodsToEncourage" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudSelect T="string" Label="Picant" @bind-Value="member.SpiceTolerance" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                @foreach (var tolerance in SpiceToleranceLevel.All)
                                                {
                                                    <MudSelectItem T="string" Value="@tolerance">@SpiceToleranceLevel.ToDisplayName(tolerance)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="9">
                                            <MudTextField T="string" Label="Preferencies de cuina" @bind-Value="member.CookingPreferences" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudPaper Class="member-measurement-panel" Elevation="0">
                                        <div class="member-bmi-summary">
                                            <div>
                                                <MudText Typo="Typo.overline">Current BMI</MudText>
                                                <MudText Typo="Typo.h6">@BmiText(member.WeightKilograms, member.HeightCentimeters)</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@MeasurementDateText(member.MeasurementDate)</MudText>
                                            </div>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @BmiNote(member)
                                            </MudText>
                                        </div>

                                        <div class="member-history-heading">
                                            <MudText Typo="Typo.subtitle2">Body measurement history</MudText>
                                            <MudButton OnClick="@(() => OpenMeasurementDialogAsync(member))"
                                                       Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Add">
                                                Add measurement
                                            </MudButton>
                                        </div>

                                        @if (member.MeasurementHistory.Count == 0)
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">No hi ha mesures guardades encara.</MudText>
                                        }
                                        else
                                        {
                                            <div class="measurement-history-wrap">
                                                <table class="measurement-history-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Data</th>
                                                            <th>Pes</th>
                                                            <th>Alcada</th>
                                                            <th>BMI</th>
                                                            <th>Greix</th>
                                                            <th>Notes</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var measurement in VisibleMeasurements(member))
                                                        {
                                                            <tr>
                                                                <td>@measurement.Date.ToString("dd/MM/yyyy", Catalan)</td>
                                                                <td>@measurement.WeightKilograms.ToString("0.#", CultureInfo.InvariantCulture) kg</td>
                                                                <td>@MeasurementHeightText(member, measurement)</td>
                                                                <td>@MeasurementBmiText(member, measurement)</td>
                                                                <td>@MeasurementBodyFatText(measurement)</td>
                                                                <td>@measurement.Notes</td>
                                                                <td class="measurement-actions">
                                                                    <MudIconButton OnClick="@(() => OpenMeasurementDialogAsync(member, measurement))"
                                                                                   Icon="@Icons.Material.Filled.Edit"
                                                                                   Size="Size.Small"
                                                                                   Color="Color.Primary"
                                                                                   aria-label="Editar mesura" />
                                                                    <MudIconButton OnClick="@(() => DeleteMeasurement(member, measurement))"
                                                                                   Icon="@Icons.Material.Filled.Delete"
                                                                                   Size="Size.Small"
                                                                                   Color="Color.Secondary"
                                                                                   aria-label="Eliminar mesura" />
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </MudPaper>

                                    <MudText Typo="Typo.subtitle2">Objectius nutricionals</MudText>
                                    <div class="settings-check-grid">
                                        @foreach (var goal in MemberNutritionGoal.All)
                                        {
                                            <MudCheckBox T="bool"
                                                         Label="@MemberNutritionGoal.ToDisplayName(goal)"
                                                         Value="@IsGoalSelected(member, goal)"
                                                         ValueChanged="@((bool selected) => SetMemberGoal(member, goal, selected))"
                                                         Color="Color.Primary" />
                                        }
                                    </div>
                                    <MudTextField T="string" Label="Objectius personalitzats" @bind-Value="member.CustomNutritionGoals" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudPaper>
                            }
                        </div>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Nutrition Goals">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("Nutrition Goals", "Objectius aproximats per menjar millor durant la setmana.")
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            Nutrition targets are always defined per person and per day. When Weekly daily average is selected, Nasdanus compares the average of the planned days with these daily values.
                        </MudAlert>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Label="Evaluation mode" @bind-Value="_settings.NutritionGoals.GoalScope" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var scope in GoalScopeOptions)
                                    {
                                        <MudSelectItem T="string" Value="@scope">@NutritionGoalScope.ToDisplayName(scope)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Label="Input mode" @bind-Value="_settings.NutritionGoals.MacroMode" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var mode in NutritionMacroMode.All)
                                    {
                                        <MudSelectItem T="string" Value="@mode">@MacroModeDisplayName(mode)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudNumericField T="decimal" Label="Calories kcal/person/day" @bind-Value="_settings.NutritionGoals.TargetCaloriesPerPerson" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        @if (_settings.NutritionGoals.MacroMode == NutritionMacroMode.PercentageDistribution)
                        {
                            @if (!IsMacroPercentValid)
                            {
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                    Protein, carbohydrates and fat must add up to 100%. Current total: @MacroPercentTotal.ToString("0.#", CultureInfo.InvariantCulture)%.
                                </MudAlert>
                            }
                            <div class="settings-grid settings-grid-four">
                                <MudNumericField T="decimal" Label="Proteina %" @bind-Value="_settings.NutritionGoals.ProteinPercent" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudNumericField T="decimal" Label="Hidrats %" @bind-Value="_settings.NutritionGoals.CarbohydratePercent" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudNumericField T="decimal" Label="Greix %" @bind-Value="_settings.NutritionGoals.FatPercent" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudPaper Class="settings-metric" Elevation="0">
                                    <MudText Typo="Typo.overline">Total</MudText>
                                    <MudText Typo="Typo.h6">@MacroPercentTotal.ToString("0", CultureInfo.InvariantCulture)%</MudText>
                                </MudPaper>
                            </div>
                            <div class="settings-grid settings-grid-four">
                                @AboutMetric("Protein calculated", $"{CalculatedProteinGrams.ToString("0.#", CultureInfo.InvariantCulture)} g/person/day")
                                @AboutMetric("Carbs calculated", $"{CalculatedCarbGrams.ToString("0.#", CultureInfo.InvariantCulture)} g/person/day")
                                @AboutMetric("Fat calculated", $"{CalculatedFatGrams.ToString("0.#", CultureInfo.InvariantCulture)} g/person/day")
                                <MudNumericField T="decimal" Label="Fibre g/person/day optional" @bind-Value="_settings.NutritionGoals.TargetFibreGramsPerPerson" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>
                        }
                        else
                        {
                            <div class="settings-grid settings-grid-four">
                                <MudNumericField T="decimal" Label="Protein g/person/day" @bind-Value="_settings.NutritionGoals.MinimumProteinGramsPerPerson" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudNumericField T="decimal" Label="Carbohydrates g/person/day" @bind-Value="_settings.NutritionGoals.TargetCarbohydrateGramsPerPerson" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudNumericField T="decimal" Label="Fat g/person/day" @bind-Value="_settings.NutritionGoals.TargetFatGramsPerPerson" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudNumericField T="decimal" Label="Fibre g/person/day optional" @bind-Value="_settings.NutritionGoals.TargetFibreGramsPerPerson" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>
                        }
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                            Household defaults are editable here. Individual goal overrides will be supported later and will always be labelled as approximate, never as medical recommendations.
                        </MudAlert>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Weekly Food Rules">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("Weekly Food Rules", "Preferencies setmanals. No bloquegen la planificacio manual.")

                        <MudText Typo="Typo.h6">Objectius setmanals</MudText>
                        <div class="settings-target-list">
                            @foreach (var target in _settings.WeeklyFoodRules.Targets)
                            {
                                <div class="settings-target-row">
                                    <MudSelect T="string" Label="Grup" @bind-Value="target.FoodGroup" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                        @foreach (var group in WeeklyTargetGroups)
                                        {
                                            <MudSelectItem T="string" Value="@group">@FoodGroupKind.ToDisplayName(group)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudSelect T="string" Label="Regla" @bind-Value="target.RuleType" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                        @foreach (var ruleType in WeeklyRuleTypes)
                                        {
                                            <MudSelectItem T="string" Value="@ruleType">@WeeklyFoodRuleType.ToDisplayName(ruleType)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudNumericField T="int" Label="Apats/setmana" @bind-Value="target.MealsPerWeek" Min="0" Max="14" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudIconButton OnClick="@(() => RemoveWeeklyTarget(target))"
                                                   Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Secondary"
                                                   aria-label="Eliminar regla" />
                                </div>
                            }
                        </div>
                        <MudButton OnClick="AddWeeklyTarget" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                            Afegir regla
                        </MudButton>

                        <MudDivider Class="settings-divider" />

                        <MudText Typo="Typo.h6">Preferred food groups by day</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Cada dia pot tenir zero, un o diversos grups preferits. Aixo nomes guia l'ordre de les recomanacions.
                        </MudText>
                        <div class="settings-day-rule-grid">
                            @foreach (var rule in _settings.WeeklyFoodRules.DayRules)
                            {
                                <MudPaper Class="settings-day-card" Elevation="0">
                                    <MudText Typo="Typo.subtitle2">@DisplayDay(rule.DayOfWeek)</MudText>
                                    @foreach (var group in DayPreferenceGroups)
                                    {
                                        <MudCheckBox T="bool"
                                                     Label="@FoodGroupKind.ToDisplayName(group)"
                                                     Value="@IsDayFoodGroupSelected(rule, group)"
                                                     ValueChanged="@((bool selected) => SetDayFoodGroup(rule, group, selected))"
                                                     Color="Color.Primary" />
                                    }
                                </MudPaper>
                            }
                        </div>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Planning Preferences">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("Planning Preferences", "Aquests criteris ordenen recomanacions, pero no amaguen receptes de la cerca manual.")
                        <div class="settings-grid settings-grid-four">
                            <MudNumericField T="int" Label="Maximum active cooking time weekdays min" @bind-Value="_settings.CookingPreferences.MaximumWeekdayCookingMinutes" Min="0" Max="240" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField T="int" Label="Maximum active cooking time weekends min" @bind-Value="_settings.CookingPreferences.MaximumWeekendCookingMinutes" Min="0" Max="360" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField T="int" Label="Avoid same recipe within days" @bind-Value="_settings.CookingPreferences.AvoidRepeatingRecipesWithinDays" Min="0" Max="90" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField T="int" Label="Desired variety window days" @bind-Value="_settings.CookingPreferences.DesiredVarietyWindowDays" Min="0" Max="90" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="settings-check-grid">
                            <MudCheckBox T="bool" Label="Use freezer meals" @bind-Value="_settings.CookingPreferences.UseFreezerMeals" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Prioritise available freezer ingredients" @bind-Value="_settings.CookingPreferences.PrioritizeAvailableFreezerIngredients" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Prioritise pantry ingredients" @bind-Value="_settings.CookingPreferences.PrioritizePantryIngredients" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Prefer seasonal ingredients" @bind-Value="_settings.CookingPreferences.PreferSeasonalIngredients" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Prefer local ingredients" @bind-Value="_settings.CookingPreferences.PreferLocalIngredients" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Prefer favourite recipes" @bind-Value="_settings.CookingPreferences.PreferFavouriteRecipes" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Prefer successfully cooked recipes" @bind-Value="_settings.CookingPreferences.PreferSuccessfullyCookedRecipes" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Allow leftovers" @bind-Value="_settings.CookingPreferences.AllowLeftovers" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Prefer batch-friendly preparations" @bind-Value="_settings.CookingPreferences.PreferBatchFriendlyPreparations" Color="Color.Primary" />
                        </div>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Ingredient Knowledge">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("Ingredient Knowledge", "Base local d'ingredients, nutricio, aliases i preferencies.")
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            Canonical data stores names, aliases, categories, nutrition and source. Household data stores favourites, usual availability, pantry/freezer flags, preferred alias and notes.
                        </MudAlert>
                        <MudPaper Class="filter-bar" Elevation="0">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="5">
                                    <MudTextField T="string"
                                                  @bind-Value="_search"
                                                  Immediate="true"
                                                  Placeholder="Cerca ingredient"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudSelect T="string"
                                               @bind-Value="_category"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Dense="true"
                                               AdornmentIcon="@Icons.Material.Filled.Category"
                                               Adornment="Adornment.Start">
                                        <MudSelectItem T="string" Value="@string.Empty">Totes</MudSelectItem>
                                        @foreach (var category in _categories)
                                        {
                                            <MudSelectItem T="string" Value="@category">@DisplayCategory(category)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="4">
                                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="settings-counts">
                                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                                            @VisibleRows.Count / @_rows.Count visibles
                                        </MudChip>
                                        <MudChip T="string" Color="@MissingNutritionColor" Variant="Variant.Outlined">
                                            @MissingNutritionCount sense nutricio
                                        </MudChip>
                                        <MudChip T="string" Color="@UnresolvedIngredientColor" Variant="Variant.Outlined">
                                            @_summary?.UnresolvedIngredients unresolved recipe ingredients
                                        </MudChip>
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                                            @ConfiguredCount marcats
                                        </MudChip>
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="settings-category-filter" role="group" aria-label="Filtres rapids per categoria">
                                        @foreach (var filter in QuickCategoryFilters)
                                        {
                                            <MudButton OnClick="@(() => SetCategory(filter.Category))"
                                                       Variant="@CategoryButtonVariant(filter.Category)"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Category">
                                                @filter.Label
                                            </MudButton>
                                        }
                                        <MudCheckBox T="bool" Label="Nomes sense nutricio" @bind-Value="_missingNutritionOnly" Color="Color.Primary" />
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        @if (VisibleRows.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No hi ha ingredients amb aquest filtre.</MudAlert>
                        }
                        else
                        {
                            <div class="ingredient-preference-list">
                                @foreach (var row in VisibleRows)
                                {
                                    <MudPaper Class="ingredient-preference-row" Elevation="0">
                                        <div class="ingredient-preference-main">
                                            <MudText Typo="Typo.subtitle1">@row.Ingredient.Name</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @DisplayTranslations(row.Ingredient)
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @DisplayCategory(row.Ingredient.Category)
                                                @if (!string.IsNullOrWhiteSpace(row.Ingredient.Subcategory))
                                                {
                                                    <span> / @row.Ingredient.Subcategory</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(row.Ingredient.NutritionSourceId))
                                                {
                                                    <span> / @row.Ingredient.NutritionSource @row.Ingredient.NutritionSourceId</span>
                                                }
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Aliases: @AliasesText(row.Ingredient)
                                            </MudText>
                                            @if (row.Ingredient.NutritionPer100Grams?.HasAnyValue == true)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @NutritionText(row.Ingredient.NutritionPer100Grams)
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">Sense nutricio</MudAlert>
                                            }
                                        </div>

                                        <div class="ingredient-preference-controls">
                                            <MudCheckBox T="bool" @bind-Value="row.Preference.IsFavourite" Color="Color.Primary" Label="Favorit" />
                                            <MudCheckBox T="bool" @bind-Value="row.Preference.IsFrequentlyUsed" Color="Color.Primary" Label="Habitual" />
                                            <MudCheckBox T="bool" @bind-Value="row.Preference.IsUsuallyAvailable" Color="Color.Primary" Label="Disponible" />
                                            <MudCheckBox T="bool" @bind-Value="row.Preference.IsAlwaysInPantry" Color="Color.Primary" Label="Sempre rebost" />
                                            <MudCheckBox T="bool" @bind-Value="row.Preference.IsNormallyFrozen" Color="Color.Primary" Label="Congelat" />
                                            <MudSelect T="string"
                                                       @bind-Value="row.Preference.UseFrequency"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Dense="true"
                                                       Label="Frequencia">
                                                @foreach (var frequency in IngredientUseFrequency.All)
                                                {
                                                    <MudSelectItem T="string" Value="@frequency">@IngredientUseFrequency.ToDisplayName(frequency)</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudTextField T="string" @bind-Value="row.Preference.PreferredAlias" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Alias de casa" />
                                            <MudTextField T="string" @bind-Value="row.Preference.HouseholdNotes" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Notes" />
                                            <MudIconButton OnClick="@(() => SaveRowAsync(row))"
                                                           Icon="@Icons.Material.Filled.Save"
                                                           Color="Color.Primary"
                                                           aria-label="Desar preferencia" />
                                        </div>
                                    </MudPaper>
                                }
                            </div>
                        }
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Inventory">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("Inventory", "Rebost com a regles, nevera com a notes i congelador com a inventari editable.")
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Pantry rules: normally always available ingredients" @bind-Value="_settings.KitchenPantry.AlwaysAvailableIngredients" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Fridge inventory notes" @bind-Value="_settings.KitchenPantry.FridgeInventoryNotes" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Pantry staples notes" @bind-Value="_settings.KitchenPantry.PantryStaplesNotes" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="Marques preferides" @bind-Value="_settings.KitchenPantry.PreferredBrands" Lines="4" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string" Label="Freezer inventory notes" @bind-Value="_settings.KitchenPantry.FreezerInventoryNotes" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        <div class="member-history-heading">
                            <div>
                                <MudText Typo="Typo.h6">Freezer inventory</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Ingredients o preparacions congelades disponibles per futures recomanacions.</MudText>
                            </div>
                            <MudButton OnClick="AddFreezerItem"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add">
                                Add freezer item
                            </MudButton>
                        </div>

                        @if (_settings.KitchenPantry.FreezerItems.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No hi ha items de congelador guardats.</MudText>
                        }
                        else
                        {
                            <div class="freezer-inventory-grid">
                                @foreach (var item in _settings.KitchenPantry.FreezerItems)
                                {
                                    <MudPaper Class="freezer-inventory-row" Elevation="0">
                                        <MudTextField T="string" Label="Ingredient or preparation" @bind-Value="item.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudNumericField T="decimal?" Label="Quantity" @bind-Value="item.Quantity" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudTextField T="string" Label="Unit" @bind-Value="item.Unit" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudDatePicker Label="Frozen date"
                                                       Date="@item.FrozenDate"
                                                       DateChanged="@((DateTime? value) => item.FrozenDate = value)"
                                                       DateFormat="dd/MM/yyyy"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense" />
                                        <MudDatePicker Label="Best-before"
                                                       Date="@item.BestBeforeDate"
                                                       DateChanged="@((DateTime? value) => item.BestBeforeDate = value)"
                                                       DateFormat="dd/MM/yyyy"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense" />
                                        <MudTextField T="string" Label="Notes" @bind-Value="item.Notes" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudIconButton OnClick="@(() => RemoveFreezerItem(item))"
                                                       Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Secondary"
                                                       aria-label="Eliminar item congelador" />
                                    </MudPaper>
                                }
                            </div>
                        }

                        <MudText Typo="Typo.h6">Electrodomestics</MudText>
                        <div class="settings-check-grid">
                            <MudCheckBox T="bool" Label="Air fryer" @bind-Value="_settings.KitchenPantry.Appliances.AirFryer" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Olla a pressio" @bind-Value="_settings.KitchenPantry.Appliances.PressureCooker" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Forn" @bind-Value="_settings.KitchenPantry.Appliances.Oven" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="BBQ" @bind-Value="_settings.KitchenPantry.Appliances.Bbq" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Thermomix" @bind-Value="_settings.KitchenPantry.Appliances.Thermomix" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Vaporera" @bind-Value="_settings.KitchenPantry.Appliances.SteamCooker" Color="Color.Primary" />
                        </div>

                        <MudButton Href="pantry" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inventory2">
                            Obrir rebost
                        </MudButton>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Shopping List">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("Shopping List", "Com generar, fusionar i ordenar la llista de la compra.")
                        <div class="settings-check-grid">
                            <MudCheckBox T="bool" Label="Ignore pantry staples" @bind-Value="_settings.Shopping.IgnorePantryItems" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Ignore always available ingredients" @bind-Value="_settings.Shopping.IgnoreAlwaysAvailableIngredients" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Deduct available freezer items when supported" @bind-Value="_settings.Shopping.DeductAvailableFreezerItems" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Merge duplicate ingredients" @bind-Value="_settings.Shopping.MergeDuplicatedIngredients" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Automatic quantity aggregation" @bind-Value="_settings.Shopping.AutomaticQuantityAggregation" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Sort order by shop/category" @bind-Value="_settings.Shopping.SortBySupermarketOrder" Color="Color.Primary" />
                            <MudCheckBox T="bool" Label="Preserve manually added items when regenerating" @bind-Value="_settings.Shopping.PreserveManualItemsWhenRegenerating" Color="Color.Primary" />
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudSelect T="string" Label="Preferred shopping units" @bind-Value="_settings.Shopping.PreferredUnits" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var mode in PreferredUnitMode.All)
                                    {
                                        <MudSelectItem T="string" Value="@mode">@PreferredUnitMode.ToDisplayName(mode)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="DayOfWeek" Label="Default fresh-shopping day" @bind-Value="_settings.Shopping.DefaultFreshShoppingDay" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var day in OrderedDays)
                                    {
                                        <MudSelectItem T="DayOfWeek" Value="@day">@DisplayDay(day)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="DayOfWeek" Label="Default general-shopping day" @bind-Value="_settings.Shopping.DefaultGeneralShoppingDay" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var day in OrderedDays)
                                    {
                                        <MudSelectItem T="DayOfWeek" Value="@day">@DisplayDay(day)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Stored Data">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("Stored Data", "Comptadors locals, backup, restore i exportacio.")
                        @if (_summary is not null)
                        {
                            <div class="data-summary-grid">
                                @SummaryMetric("Receptes", _summary.Recipes)
                                @SummaryMetric("Draft recipes", _summary.DraftRecipes)
                                @SummaryMetric("Ingredients", _summary.Ingredients)
                                @SummaryMetric("Linked ingredients", _summary.LinkedIngredients)
                                @SummaryMetric("Unresolved ingredients", _summary.UnresolvedIngredients)
                                @SummaryMetric("Planner entries", _summary.MealPlanSlots)
                                @SummaryMetric("Shopping lists", _summary.ShoppingLists)
                                @SummaryMetric("Prefs ingredients", _summary.HouseholdIngredientPreferences)
                                @SummaryMetric("Compra", _summary.ShoppingItems)
                                @SummaryMetric("Rebost", _summary.PantryItems)
                                @SummaryMetric("Freezer items", _summary.FreezerItems)
                                @SummaryMetric("Household members", _summary.HouseholdMembers)
                                @SummaryMetric("Measurements", _summary.Measurements)
                                @SummaryMetric("Product Backlog", _summary.ProductBacklogItems)
                            </div>
                        }
                        <div class="settings-link-grid">
                            <MudButton Href="data" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Storage">Backup / Restore</MudButton>
                            <MudButton Href="data" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload">Exportar JSON</MudButton>
                            <MudButton Href="data" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile">Importar JSON</MudButton>
                        </div>
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            Restore and reset actions live in Data and must show a clear warning before replacing or deleting local data.
                        </MudAlert>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="About">
                    <MudPaper Class="settings-section" Elevation="0">
                        @SectionHeading("About", "Versions i fonts locals.")
                        <div class="settings-grid settings-grid-four">
                            @AboutMetric("Application version", AppInfo.Version)
                            @AboutMetric("Knowledge DB version", "Mediterranean starter v1")
                            @AboutMetric("Knowledge Importer", "Nasdanus.KnowledgeImporter v1")
                            @AboutMetric("Known ingredients", $"{_rows.Count} ingredients")
                            @AboutMetric("Last knowledge update", KnowledgeLastUpdatedText)
                            @AboutMetric("Local storage", "Browser local storage")
                            @AboutMetric("PWA version", AppInfo.Version)
                        </div>
                        <MudPaper Class="source-priority-panel" Elevation="0">
                            <MudText Typo="Typo.h6">Nutrition source strategy</MudText>
                            <ol>
                                <li><strong>BEDCA</strong> - primary Spanish generic foods when suitable data is available.</li>
                                <li><strong>CIQUAL</strong> - complementary European source when BEDCA is missing or less complete.</li>
                                <li><strong>Open Food Facts</strong> - branded, packaged and commercially processed products.</li>
                                <li><strong>USDA FoodData Central / SR Legacy</strong> - fallback when no suitable European source is available.</li>
                            </ol>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Each ingredient preserves source provider, source record ID, raw/cooked state and last updated date.
                            </MudText>
                        </MudPaper>
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>
        }
    </MudStack>
</MudContainer>

@code {
    private static readonly CultureInfo Catalan = CultureInfo.GetCultureInfo("ca-ES");

    private HouseholdPlanningSettings? _settings;
    private DataBackupSummary? _summary;
    private List<HouseholdIngredientPreferenceRow> _rows = [];
    private List<string> _categories = [];
    private string _search = string.Empty;
    private string _category = string.Empty;
    private bool _missingNutritionOnly;
    private bool _isLoading = true;
    private bool _isSavingSettings;
    private bool _isSavingIngredients;

    private static readonly string[] GoalScopeOptions =
    [
        NutritionGoalScope.Daily,
        NutritionGoalScope.WeeklyAverage
    ];

    private static readonly string[] WeeklyRuleTypes =
    [
        WeeklyFoodRuleType.Minimum,
        WeeklyFoodRuleType.Maximum
    ];

    private static readonly string[] WeeklyTargetGroups =
    [
        FoodGroupKind.BlueFish,
        FoodGroupKind.WhiteFish,
        FoodGroupKind.Seafood,
        FoodGroupKind.Legumes,
        FoodGroupKind.Eggs,
        FoodGroupKind.Poultry,
        FoodGroupKind.RedMeat,
        FoodGroupKind.Vegetables,
        FoodGroupKind.VegetableRich,
        FoodGroupKind.Vegetarian,
        FoodGroupKind.Pasta,
        FoodGroupKind.Rice,
        FoodGroupKind.HomemadeFastFood,
        FoodGroupKind.Desserts
    ];

    private static readonly string[] DayPreferenceGroups =
    [
        FoodGroupKind.Fish,
        FoodGroupKind.Vegetables,
        FoodGroupKind.Legumes,
        FoodGroupKind.Eggs,
        FoodGroupKind.HighProtein,
        FoodGroupKind.Poultry,
        FoodGroupKind.RedMeat,
        FoodGroupKind.Pasta,
        FoodGroupKind.Rice
    ];

    private static readonly CategoryFilter[] QuickCategoryFilters =
    [
        new(string.Empty, "Totes"),
        new("fruit", "Fruita"),
        new("vegetables", "Verdures"),
        new("meat", "Carn"),
        new("fish", "Peix"),
        new("dairy-eggs", "Lactis i ous"),
        new("legumes", "Llegums"),
        new("grains", "Cereals"),
        new("pantry", "Rebost"),
        new("spices", "Especies")
    ];

    private static IReadOnlyList<DayOfWeek> OrderedDays => Enum.GetValues<DayOfWeek>()
        .OrderBy(day => day == DayOfWeek.Sunday ? 6 : (int)day - 1)
        .ToList();

    private decimal MacroPercentTotal => _settings is null
        ? 0
        : _settings.NutritionGoals.ProteinPercent
            + _settings.NutritionGoals.CarbohydratePercent
            + _settings.NutritionGoals.FatPercent;

    private bool IsMacroPercentValid => _settings?.NutritionGoals.MacroMode != NutritionMacroMode.PercentageDistribution
        || MacroPercentTotal == 100m;
    private decimal CalculatedProteinGrams => CalculatedMacroGrams(_settings?.NutritionGoals.ProteinPercent ?? 0, 4);
    private decimal CalculatedCarbGrams => CalculatedMacroGrams(_settings?.NutritionGoals.CarbohydratePercent ?? 0, 4);
    private decimal CalculatedFatGrams => CalculatedMacroGrams(_settings?.NutritionGoals.FatPercent ?? 0, 9);
    private int ConfiguredCount => _rows.Count(row => HasConfiguredPreference(row.Preference));
    private int MissingNutritionCount => _rows.Count(row => row.Ingredient.NutritionPer100Grams?.HasAnyValue != true);
    private Color MissingNutritionColor => MissingNutritionCount == 0 ? Color.Success : Color.Warning;
    private Color UnresolvedIngredientColor => _summary?.UnresolvedIngredients > 0 ? Color.Warning : Color.Success;
    private string KnowledgeLastUpdatedText => _rows
        .Select(row => row.Ingredient.NutritionLastUpdated)
        .Where(date => date is not null)
        .Select(date => date!.Value)
        .DefaultIfEmpty()
        .Max() is { } lastUpdated && lastUpdated != default
            ? lastUpdated.ToString("dd/MM/yyyy", Catalan)
            : "Not recorded";

    private List<HouseholdIngredientPreferenceRow> VisibleRows => _rows
        .Where(MatchesFilters)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        _settings = await PlanningSettings.GetSettingsAsync();
        _rows = await Preferences.GetRowsAsync();
        _summary = await Store.GetSummaryAsync();
        _categories = _rows
            .Select(row => row.Ingredient.Category)
            .Where(category => !string.IsNullOrWhiteSpace(category))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(category => category)
            .ToList();
    }

    private async Task SaveSettingsAsync()
    {
        if (_settings is null)
        {
            return;
        }

        if (!IsMacroPercentValid)
        {
            Snackbar.Add("Els percentatges de proteina, hidrats i greix han de sumar 100%.", Severity.Warning);
            return;
        }

        _isSavingSettings = true;
        try
        {
            await PlanningSettings.SaveSettingsAsync(_settings);
            _settings = await PlanningSettings.GetSettingsAsync();
            _summary = await Store.GetSummaryAsync();
            Snackbar.Add("Configuracio desada.", Severity.Success);
        }
        finally
        {
            _isSavingSettings = false;
        }
    }

    private async Task SaveRowAsync(HouseholdIngredientPreferenceRow row)
    {
        await Preferences.SaveAsync(row.Preference);
        await LoadAsync();
        Snackbar.Add("Preferencia desada.", Severity.Success);
    }

    private async Task SaveAllIngredientsAsync()
    {
        _isSavingIngredients = true;
        try
        {
            await Preferences.SaveManyAsync(_rows.Select(row => row.Preference));
            await LoadAsync();
            Snackbar.Add("Ingredients desats.", Severity.Success);
        }
        finally
        {
            _isSavingIngredients = false;
        }
    }

    private void AddWeeklyTarget()
    {
        _settings?.WeeklyFoodRules.Targets.Add(new WeeklyFoodTarget
        {
            FoodGroup = FoodGroupKind.VegetableRich,
            RuleType = WeeklyFoodRuleType.Minimum,
            MealsPerWeek = 1
        });
    }

    private void RemoveWeeklyTarget(WeeklyFoodTarget target)
    {
        _settings?.WeeklyFoodRules.Targets.Remove(target);
    }

    private void AddMember()
    {
        _settings?.Members.Add(new HouseholdMemberProfile
        {
            Name = "Nou membre",
            ActivityLevel = MemberActivityLevel.Moderate,
            Sex = MemberSex.Unspecified,
            SpiceTolerance = SpiceToleranceLevel.Medium,
            NutritionGoals = [MemberNutritionGoal.ImproveOverallDiet]
        });
    }

    private void RemoveMember(HouseholdMemberProfile member)
    {
        _settings?.Members.Remove(member);
    }

    private async Task OpenMeasurementDialogAsync(HouseholdMemberProfile member, BodyMeasurement? measurement = null)
    {
        var parameters = new DialogParameters<BodyMeasurementDialog>
        {
            { dialog => dialog.Measurement, measurement },
            { dialog => dialog.IsChild, IsMinor(member) }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var title = measurement is null ? "Add measurement" : "Edit measurement";
        var dialog = await DialogService.ShowAsync<BodyMeasurementDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not BodyMeasurement saved)
        {
            return;
        }

        member.MeasurementHistory ??= [];
        if (measurement is null)
        {
            member.MeasurementHistory.Add(saved);
        }
        else
        {
            var index = member.MeasurementHistory.FindIndex(existing => existing.Id == measurement.Id);
            if (index >= 0)
            {
                member.MeasurementHistory[index] = saved;
            }
        }

        ApplyLatestMeasurement(member);
    }

    private static void DeleteMeasurement(HouseholdMemberProfile member, BodyMeasurement measurement)
    {
        member.MeasurementHistory.RemoveAll(existing => existing.Id == measurement.Id);
        ApplyLatestMeasurement(member);
    }

    private static void ApplyLatestMeasurement(HouseholdMemberProfile member)
    {
        var latest = member.MeasurementHistory
            .OrderByDescending(measurement => measurement.Date)
            .FirstOrDefault();
        if (latest is null)
        {
            return;
        }

        member.MeasurementDate = latest.Date;
        member.WeightKilograms = latest.WeightKilograms;
        if (latest.HeightCentimeters is > 0)
        {
            member.HeightCentimeters = latest.HeightCentimeters.Value;
        }

        member.BodyFatPercentage = latest.BodyFatPercentage;
    }

    private static bool IsDayFoodGroupSelected(DayFoodRule rule, string group) =>
        rule.FoodGroups.Contains(group, StringComparer.OrdinalIgnoreCase);

    private static void SetDayFoodGroup(DayFoodRule rule, string group, bool selected)
    {
        rule.FoodGroups ??= [];
        if (selected && !rule.FoodGroups.Contains(group, StringComparer.OrdinalIgnoreCase))
        {
            rule.FoodGroups.Add(group);
        }
        else if (!selected)
        {
            rule.FoodGroups.RemoveAll(existing => string.Equals(existing, group, StringComparison.OrdinalIgnoreCase));
        }

        rule.FoodGroup = rule.FoodGroups.FirstOrDefault() ?? FoodGroupKind.None;
    }

    private void AddFreezerItem()
    {
        _settings?.KitchenPantry.FreezerItems.Add(new FreezerInventoryItem
        {
            FrozenDate = DateTime.Today
        });
    }

    private void RemoveFreezerItem(FreezerInventoryItem item)
    {
        _settings?.KitchenPantry.FreezerItems.Remove(item);
    }

    private static bool IsGoalSelected(HouseholdMemberProfile member, string goal) =>
        member.NutritionGoals.Contains(goal);

    private static void SetMemberGoal(HouseholdMemberProfile member, string goal, bool selected)
    {
        if (selected && !member.NutritionGoals.Contains(goal))
        {
            member.NutritionGoals.Add(goal);
        }
        else if (!selected)
        {
            member.NutritionGoals.RemoveAll(existing => existing == goal);
        }
    }

    private bool MatchesFilters(HouseholdIngredientPreferenceRow row)
    {
        if (_missingNutritionOnly && row.Ingredient.NutritionPer100Grams?.HasAnyValue == true)
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_category)
            && !string.Equals(row.Ingredient.Category, _category, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var search = _search.Trim();
        return row.Ingredient.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
            || row.Ingredient.CatalanName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || row.Ingredient.SpanishName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || row.Ingredient.Aliases.Any(alias => alias.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private void SetCategory(string category)
    {
        _category = category;
    }

    private Variant CategoryButtonVariant(string category) =>
        string.Equals(_category, category, StringComparison.OrdinalIgnoreCase)
            ? Variant.Filled
            : Variant.Outlined;

    private static bool HasConfiguredPreference(HouseholdIngredientPreference preference) =>
        preference.IsFavourite
        || preference.IsFrequentlyUsed
        || preference.IsUsuallyAvailable
        || preference.IsAlwaysInPantry
        || preference.IsNormallyFrozen
        || preference.UseFrequency != IngredientUseFrequency.Occasional
        || !string.IsNullOrWhiteSpace(preference.PreferredAlias)
        || !string.IsNullOrWhiteSpace(preference.HouseholdNotes);

