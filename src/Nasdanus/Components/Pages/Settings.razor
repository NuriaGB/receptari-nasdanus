    private static string DisplayDay(DayOfWeek day) =>
        Catalan.DateTimeFormat.GetDayName(day);

    private static string MemberTitle(HouseholdMemberProfile member) =>
        string.IsNullOrWhiteSpace(member.Name) ? "Membre sense nom" : member.Name;

    private static string AgeText(HouseholdMemberProfile member)
    {
        var age = AgeYears(member);
        return age is null ? "Edat pendent" : $"{age.Value} anys";
    }

    private static int? AgeYears(HouseholdMemberProfile member)
    {
        if (member.DateOfBirth is null)
        {
            return null;
        }

        var today = DateTime.Today;
        var birthDate = member.DateOfBirth.Value.Date;
        var age = today.Year - birthDate.Year;
        if (birthDate.Date > today.AddYears(-age))
        {
            age--;
        }

        return Math.Max(0, age);
    }

    private static bool IsMinor(HouseholdMemberProfile member) =>
        AgeYears(member) is < 18;

    private static decimal? Bmi(decimal weightKilograms, decimal heightCentimeters)
    {
        if (weightKilograms <= 0 || heightCentimeters <= 0)
        {
            return null;
        }

        var heightMeters = heightCentimeters / 100m;
        return weightKilograms / (heightMeters * heightMeters);
    }

    private static string BmiText(decimal weightKilograms, decimal heightCentimeters) =>
        Bmi(weightKilograms, heightCentimeters)?.ToString("0.0", CultureInfo.InvariantCulture) ?? "Pendent";

    private static string BmiNote(HouseholdMemberProfile member) =>
        IsMinor(member)
            ? "BMI may be calculated for minors, but interpretation depends on age- and sex-specific growth references. Nasdanus does not classify or diagnose."
            : "BMI is only a general reference and does not directly measure body composition. Nasdanus does not diagnose or prescribe.";

    private static IEnumerable<BodyMeasurement> VisibleMeasurements(HouseholdMemberProfile member) =>
        (member.MeasurementHistory ?? [])
            .OrderByDescending(measurement => measurement.Date);

    private static string MeasurementDateText(DateTime? date) =>
        date is null ? "Data de mesura pendent" : $"Mesura: {date.Value.ToString("dd/MM/yyyy", Catalan)}";

    private static string MeasurementHeightText(HouseholdMemberProfile member, BodyMeasurement measurement)
    {
        var height = measurement.HeightCentimeters ?? member.HeightCentimeters;
        return height > 0 ? $"{height.ToString("0.#", CultureInfo.InvariantCulture)} cm" : "-";
    }

    private static string MeasurementBmiText(HouseholdMemberProfile member, BodyMeasurement measurement)
    {
        var height = measurement.HeightCentimeters ?? member.HeightCentimeters;
        return Bmi(measurement.WeightKilograms, height)?.ToString("0.0", CultureInfo.InvariantCulture) ?? "-";
    }

    private static string MeasurementBodyFatText(BodyMeasurement measurement) =>
        measurement.BodyFatPercentage is null
            ? "-"
            : $"{measurement.BodyFatPercentage.Value.ToString("0.#", CultureInfo.InvariantCulture)}%";

    private decimal CalculatedMacroGrams(decimal percent, decimal caloriesPerGram)
    {
        if (_settings is null || _settings.NutritionGoals.TargetCaloriesPerPerson <= 0 || caloriesPerGram <= 0)
        {
            return 0;
        }

        return Math.Round(_settings.NutritionGoals.TargetCaloriesPerPerson * percent / 100m / caloriesPerGram, 1);
    }

    private static string MacroModeDisplayName(string mode) => mode switch
    {
        NutritionMacroMode.AbsoluteGrams => "Grams per person per day",
        NutritionMacroMode.PercentageDistribution => "Percentage of calories",
        _ => mode
    };

    private static string DisplayTranslations(Ingredient ingredient)
    {
        var names = new[] { ingredient.CatalanName, ingredient.SpanishName }
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return names.Count == 0 ? "Sense traduccions" : string.Join(" / ", names);
    }

    private static string AliasesText(Ingredient ingredient) =>
        ingredient.Aliases.Count == 0
            ? "Sense aliases"
            : string.Join(", ", ingredient.Aliases);

    private static string NutritionText(IngredientNutrition nutrition) =>
        $"{nutrition.CaloriesKcal?.ToString("0", CultureInfo.InvariantCulture) ?? "-"} kcal · "
        + $"{nutrition.ProteinGrams?.ToString("0.#", CultureInfo.InvariantCulture) ?? "-"} g prot · "
        + $"{nutrition.CarbohydrateGrams?.ToString("0.#", CultureInfo.InvariantCulture) ?? "-"} g hidrats · "
        + $"{nutrition.FatGrams?.ToString("0.#", CultureInfo.InvariantCulture) ?? "-"} g greix";

