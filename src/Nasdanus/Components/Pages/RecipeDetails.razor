@page "/recipes/{Id:int}"
@using System.Globalization
@inject RecipeService Recipes
@inject RecipeExchangeService RecipeExchange
@inject PlannerService Planner
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>@(_recipe is null ? "Recepta" : _recipe.Name)</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="page-shell recipe-detail-shell">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_recipe is null)
    {
        <MudAlert Severity="Severity.Warning">No s'ha trobat la recepta.</MudAlert>
    }
    else
    {
        var profile = RecipeLibraryAnalysis.Analyze(_recipe);

        <MudStack Spacing="3">
            <MudButton Href="recipes"
                       Class="screen-only"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                Receptes
            </MudButton>

            <div class="page-heading recipe-heading">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="recipe-badges">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@CategoryText</MudChip>
                    @if (_recipe.IsDraft)
                    {
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">Draft</MudChip>
                    }
                    @if (_recipe.VariationOfRecipeId is not null)
                    {
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Variacio</MudChip>
                    }
                </MudStack>
                <MudText Typo="Typo.h3">@_recipe.Name</MudText>
                @if (!string.IsNullOrWhiteSpace(_recipe.Description))
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary">@_recipe.Description</MudText>
                }
                @if (_sourceRecipe is not null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Variacio de <MudLink Href="@($"recipes/{_sourceRecipe.Id}")">@_sourceRecipe.Name</MudLink>
                    </MudText>
                }
            </div>

            <MudStack Row Class="recipe-actions">
                <MudButton Href="@CookHref"
                           Class="recipe-primary-action"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Restaurant">
                    Cuinar
                </MudButton>
                <MudButton Href="@($"recipes/{_recipe.Id}/edit")"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Edit">
                    Editar
                </MudButton>
                <MudButton OnClick="CreateVariationAsync"
                           Disabled="@_isMutating"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.ContentCopy">
                    Fer variacio
                </MudButton>
                <MudButton OnClick="OpenImportDialogAsync"
                           Disabled="@_isMutating"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.UploadFile">
                    Importar
                </MudButton>
                <MudButton OnClick="ExportRecipeAsync"
                           Disabled="@_isExporting"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.FileDownload">
                    Exportar
                </MudButton>
                <MudButton OnClick="PrintRecipeAsync"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Print">
                    Imprimir
                </MudButton>
                @if (_recipe.IsDraft)
                {
                    <MudButton OnClick="ConsolidateAsync"
                               Disabled="@_isMutating"
                               Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.CheckCircle">
                        Consolidar
                    </MudButton>
                }
                <MudButton OnClick="ConfirmDeleteAsync"
                           Disabled="@_isMutating"
                           Variant="Variant.Outlined"
                           Color="Color.Error"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Delete">
                    Esborrar
                </MudButton>
            </MudStack>

            <MudGrid Spacing="2" Class="recipe-meta-grid">
                <MudItem xs="6" sm="3">
                    <MudPaper Class="metric" Elevation="0">
                        <MudText Typo="Typo.overline">Preparació</MudText>
                        <MudText Typo="Typo.h6">@_recipe.PreparationTimeMinutes min</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="metric" Elevation="0">
                        <MudText Typo="Typo.overline">Cocció</MudText>
                        <MudText Typo="Typo.h6">@_recipe.CookingTimeMinutes min</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="metric" Elevation="0">
                        <MudText Typo="Typo.overline">Dificultat</MudText>
                        <MudText Typo="Typo.h6">@_recipe.Difficulty</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudPaper Class="metric" Elevation="0">
                        <MudText Typo="Typo.overline">Racions</MudText>
                        <MudText Typo="Typo.h6">@_recipe.Servings</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudPaper id="recipe-status" Class="recipe-status-panel" Elevation="0">
                <div class="recipe-status-heading">
                    <div>
                        <MudText Typo="Typo.overline">Recipe Status</MudText>
                        <MudText Typo="Typo.h5">@profile.CompletionPercent% complete</MudText>
                    </div>
                    <MudChip T="string" Color="@(profile.NextAction.IsComplete ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                        @profile.NextAction.Label
                    </MudChip>
                </div>
                <MudProgressLinear Value="@profile.CompletionPercent" Color="@CompletionColor(profile)" Rounded="true" />
                <div class="recipe-status-grid">
                    @foreach (var item in profile.CompletionItems)
                    {
                        <div class="recipe-status-item @(item.IsComplete ? "is-complete" : "is-missing")">
                            <MudIcon Icon="@(item.IsComplete ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                                     Color="@(item.IsComplete ? Color.Success : Color.Warning)"
                                     Size="Size.Small" />
                            <span>@item.Label</span>
                        </div>
                    }
                </div>
                <div class="recipe-next-action">
                    <div>
                        <MudText Typo="Typo.overline">Next Action</MudText>
                        <MudText Typo="Typo.subtitle1">@profile.NextAction.Label</MudText>
                    </div>
                    <MudStack Row Class="recipe-status-actions">
                        @if (!profile.NextAction.IsComplete)
                        {
                            <MudButton Href="@RecipeLibraryAnalysis.WorkHref(_recipe, profile.NextAction)"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@WorkActionIcon(profile.NextAction)">
                                Work on Next Action
                            </MudButton>
                        }
                        @if (profile.NextAction.Key == RecipeWorkflowActionKind.ReviewAfterCooking)
                        {
                            <MudButton OnClick="MarkFamilyApprovedAsync"
                                       Disabled="@_isMutating"
                                       Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.ThumbUp">
                                Family Approved
                            </MudButton>
                        }
                    </MudStack>
                </div>
            </MudPaper>

            <MudPaper Class="serving-scale-panel" Elevation="0">
                <div>
                    <MudText Typo="Typo.subtitle1">Racions</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Base de la recepta: @_recipe.Servings racions
                    </MudText>
                </div>
                <MudNumericField T="int"
                                 Label="@ServingInputLabel"
                                 @bind-Value="_displayServings"
                                 Min="1"
                                 Disabled="@IsPlannedContext"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Groups" />
            </MudPaper>

            <NutritionSummary Title="Nutricio aproximada"
                              Subtitle="Per racio"
                              Totals="@RecipeNutritionPerServing" />

            <MudPaper Class="detail-section ingredient-section" Elevation="0">
                <MudText Typo="Typo.h5">Ingredients</MudText>
                @if (_recipe.Ingredients.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Encara no hi ha ingredients.</MudText>
                }
                else
                {
                    <MudList T="RecipeIngredient" Dense="true" Class="ingredient-list">
                        @foreach (var ingredient in _recipe.Ingredients.OrderBy(ingredient => ingredient.Order))
                        {
                            <MudListItem Icon="@Icons.Material.Filled.CheckCircleOutline">
                                @ingredient.ToDisplayText(ScaleFactor)
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>

            <MudPaper Class="detail-section steps-section" Elevation="0">
                <MudText Typo="Typo.h5">Passos</MudText>
                @if (_recipe.Steps.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Encara no hi ha passos.</MudText>
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var step in _recipe.Steps.OrderBy(step => step.Order))
                        {
                            <div class="detail-step">
                                <MudText Typo="Typo.subtitle1">@step.Order. @step.Title</MudText>
                                <MudText Typo="Typo.body1">@step.Instruction</MudText>
                                @if (step.TimerMinutes is not null)
                                {
                                    <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Timer">
                                        @step.TimerMinutes min
                                    </MudChip>
                                }
                            </div>
                        }
                    </MudStack>
                }
            </MudPaper>

            <MudPaper Class="detail-section notes-section" Elevation="0">
                <MudText Typo="Typo.h5">Notes</MudText>
                @if (_recipe.Notes.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Encara no hi ha notes.</MudText>
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var section in RecipeNoteSection.DisplayOrder)
                        {
                            var notes = NotesFor(section);
                            if (notes.Count == 0)
                            {
                                continue;
                            }

                            <div class="recipe-note-section">
                                <MudText Typo="Typo.subtitle1">@RecipeNoteSection.ToDisplayName(section)</MudText>
                                <MudList T="RecipeNote" Dense="true">
                                    @foreach (var note in notes)
                                    {
                                        <MudListItem Icon="@Icons.Material.Filled.StickyNote2">
                                            @note.Content
                                        </MudListItem>
                                    }
                                </MudList>
                            </div>
                        }
                    </MudStack>
                }
            </MudPaper>
        </MudStack>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "plannedMealId")]
    public int? PlannedMealId { get; set; }

    [SupplyParameterFromQuery(Name = "servings")]
    public int? QueryServings { get; set; }

    private Recipe? _recipe;
    private Recipe? _sourceRecipe;
    private MealPlanRecipe? _plannedRecipe;
    private bool _isLoading = true;
    private bool _isMutating;
    private bool _isExporting;
    private int _displayServings = 1;
    private string CategoryText => string.IsNullOrWhiteSpace(_recipe?.Category) ? "Sense categoria" : _recipe.Category;
    private bool IsPlannedContext => _plannedRecipe is not null;
    private string ServingInputLabel => IsPlannedContext ? "Racions planificades" : "Racions temporals";
    private decimal ScaleFactor => _recipe is null ? 1 : IngredientScaling.ScaleFactor(_recipe.Servings, _displayServings);
    private NutritionTotals RecipeNutrition => _recipe is null ? new NutritionTotals() : NutritionService.CalculateRecipe(_recipe, _displayServings);
    private NutritionTotals RecipeNutritionPerServing => NutritionService.PerServing(RecipeNutrition, _displayServings);
    private string CookHref
    {
        get
        {
            if (_recipe is null)
            {
                return "recipes";
            }

            return IsPlannedContext
                ? $"cook/{_recipe.Id}?plannedMealId={_plannedRecipe!.Id}"
                : $"cook/{_recipe.Id}?servings={_displayServings}";
        }
    }

    private IReadOnlyList<RecipeNote> NotesFor(string section) =>
        _recipe?.Notes
            .Where(note => note.Section == section)
            .OrderBy(note => note.Order)
            .ToList() ?? [];

    private static Color CompletionColor(RecipeLibraryProfile profile) =>
        profile.CompletionPercent >= 80
            ? Color.Success
            : profile.CompletionPercent >= 50
                ? Color.Warning
                : Color.Error;

    private static string WorkActionIcon(RecipeWorkflowAction action) => action.TargetKind switch
    {
        RecipeWorkflowTargetKind.Cook => Icons.Material.Filled.Restaurant,
        RecipeWorkflowTargetKind.Details => Icons.Material.Filled.RateReview,
        _ => Icons.Material.Filled.Build
    };

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        await LoadRecipeContextAsync();
        _isLoading = false;
    }

    private async Task LoadRecipeContextAsync()
    {
        _recipe = await Recipes.GetByIdAsync(Id);
        _sourceRecipe = _recipe?.VariationOfRecipeId is int sourceId && sourceId != _recipe.Id
            ? await Recipes.GetByIdAsync(sourceId)
            : null;
        _plannedRecipe = null;
        if (_recipe is not null && PlannedMealId is int plannedMealId)
        {
            var plannedRecipe = await Planner.GetPlannedRecipeAsync(plannedMealId);
            if (plannedRecipe?.RecipeId == _recipe.Id)
            {
                _plannedRecipe = plannedRecipe;
            }
        }

        _displayServings = _plannedRecipe?.PlannedServings > 0
            ? _plannedRecipe.PlannedServings
            : QueryServings is > 0
                ? QueryServings.Value
                : _recipe?.Servings > 0
                    ? _recipe.Servings
                    : 1;
    }

    private async Task ConsolidateAsync()
    {
        if (_recipe is null)
        {
            return;
        }

        _isMutating = true;
        await Recipes.ConsolidateAsync(_recipe.Id);
        _recipe = await Recipes.GetByIdAsync(_recipe.Id);
        _sourceRecipe = _recipe?.VariationOfRecipeId is int sourceId && sourceId != _recipe.Id
            ? await Recipes.GetByIdAsync(sourceId)
            : null;
        _isMutating = false;
        Snackbar.Add("Recepta consolidada.", Severity.Success);
    }

    private async Task MarkFamilyApprovedAsync()
    {
        if (_recipe is null)
        {
            return;
        }

        _isMutating = true;
        await Recipes.MarkFamilyApprovedAsync(_recipe.Id);
        _recipe = await Recipes.GetByIdAsync(_recipe.Id);
        _isMutating = false;
        Snackbar.Add("Recepta aprovada per la familia.", Severity.Success);
    }

    private async Task CreateVariationAsync()
    {
        if (_recipe is null)
        {
            return;
        }

        _isMutating = true;
        var variation = await Recipes.CreateVariationAsync(_recipe.Id);
        _isMutating = false;
        if (variation is not null)
        {
            Navigation.NavigateTo($"recipes/{variation.Id}/edit");
        }
    }

    private async Task OpenImportDialogAsync()
    {
        if (_recipe is null)
        {
            return;
        }

        var parameters = new DialogParameters<RecipeImportDialog>
        {
            { dialog => dialog.Recipe, _recipe }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = await DialogService.ShowAsync<RecipeImportDialog>("Importar sobre aquesta recepta", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await LoadRecipeContextAsync();
        Snackbar.Add("Recepta actualitzada amb la fitxa importada.", Severity.Success);
    }

    private async Task ExportRecipeAsync()
    {
        if (_recipe is null)
        {
            return;
        }

        _isExporting = true;
        try
        {
            var json = await RecipeExchange.ExportRecipeAsync(_recipe.Id);
            if (json is null)
            {
                Snackbar.Add("No s'ha trobat la recepta.", Severity.Warning);
                return;
            }

            await JS.InvokeVoidAsync(
                "nasdanusData.downloadTextFile",
                RecipeFileName(_recipe),
                json,
                "application/json;charset=utf-8");
            Snackbar.Add("Recepta exportada.", Severity.Success);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task PrintRecipeAsync()
    {
        await JS.InvokeVoidAsync("nasdanusData.printRecipe");
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_recipe is null)
        {
            return;
        }

        var parameters = new DialogParameters<DeleteRecipeDialog>
        {
            { dialog => dialog.Recipe, _recipe }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraSmall
        };

        var dialog = await DialogService.ShowAsync<DeleteRecipeDialog>("Esborrar recepta", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        _isMutating = true;
        var deleteResult = await Recipes.DeleteAsync(_recipe.Id);
        _isMutating = false;
        if (!deleteResult.Deleted)
        {
            Snackbar.Add("No s'ha trobat la recepta.", Severity.Warning);
            Navigation.NavigateTo("recipes");
            return;
        }

        Snackbar.Add(DeleteSuccessText(deleteResult), Severity.Success);
        Navigation.NavigateTo("recipes");
    }

    private static string DeleteSuccessText(RecipeDeleteResult result)
    {
        var details = new List<string>();
        if (result.RemovedPlannedRecipes > 0)
        {
            details.Add($"{result.RemovedPlannedRecipes} planning");
        }

        if (result.RemovedRecipeIdeas > 0)
        {
            details.Add($"{result.RemovedRecipeIdeas} idees");
        }

        if (result.DetachedShoppingItems > 0)
        {
            details.Add($"{result.DetachedShoppingItems} items de compra desenllacats");
        }

        return details.Count == 0
            ? "Recepta esborrada."
            : $"Recepta esborrada ({string.Join(", ", details)}).";
    }

    private static string RecipeFileName(Recipe recipe)
    {
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm", CultureInfo.InvariantCulture);
        var name = Slug(recipe.Name);
        return $"nasdanus-recepta-{name}-{stamp}.json";
    }

    private static string Slug(string value)
    {
        var chars = value
            .Trim()
            .ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-')
            .ToArray();
        var slug = string.Join("-", new string(chars)
            .Split('-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return string.IsNullOrWhiteSpace(slug) ? "recepta" : slug;
    }
}
