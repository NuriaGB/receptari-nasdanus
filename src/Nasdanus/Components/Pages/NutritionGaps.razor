@page "/nutrition-gaps"
@using System.Globalization
@inject IngredientKnowledgeService IngredientKnowledge
@inject RecipeService Recipes
@inject PlannerService Planner
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Nasdanus - Buits de nutricio</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="page-shell nutrition-gaps-shell">
    <MudStack Spacing="3">
        <div class="page-heading page-heading-actions">
            <div>
                <MudText Typo="Typo.overline">Nutricio</MudText>
                <MudText Typo="Typo.h3">Buits d'ingredients</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Llista operativa per deixar el planner prou fiable per quadrar proteina, kcal i macros.
                </MudText>
            </div>
            <MudButton Href="settings"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Settings">
                Config
            </MudButton>
        </div>

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <div class="gap-metric-grid">
                @GapMetric("Setmana", FilteredPlannedIssues.Count, "incidencies", GapMode.Planned, Color.Warning)
                @GapMetric("Sense nutricio", FilteredKnownMissingIngredients.Count, "ingredients", GapMode.MissingNutrition, MissingNutritionColor)
                @GapMetric("Unresolved", FilteredUnresolvedGroups.Count, "ingredients", GapMode.Unresolved, UnresolvedColor)
                @GapMetric("Quantitat", FilteredQuantityIssues.Count, "receptes", GapMode.Quantity, QuantityColor)
            </div>

            <MudPaper Class="filter-bar" Elevation="0">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="5">
                        <MudTextField T="string"
                                      @bind-Value="_search"
                                      Immediate="true"
                                      Placeholder="Cerca ingredient o recepta"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                    <MudItem xs="12" md="7">
                        <div class="gap-mode-buttons" role="group" aria-label="Tipus de buits">
                            @ModeButton(GapMode.Planned, "Setmana", Icons.Material.Filled.CalendarMonth, Color.Warning)
                            @ModeButton(GapMode.MissingNutrition, "Sense nutricio", Icons.Material.Filled.Edit, MissingNutritionColor)
                            @ModeButton(GapMode.Unresolved, "Unresolved", Icons.Material.Filled.LinkOff, UnresolvedColor)
                            @ModeButton(GapMode.Quantity, "Quantitat", Icons.Material.Filled.Scale, QuantityColor)
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (_mode == GapMode.Planned)
            {
                @PlannedIssuesPanel()
            }
            else if (_mode == GapMode.MissingNutrition)
            {
                @KnownMissingNutritionPanel()
            }
            else if (_mode == GapMode.Unresolved)
            {
                @UnresolvedPanel()
            }
            else
            {
                @QuantityPanel()
            }
        }
    </MudStack>
</MudContainer>

@code {
    private static readonly CultureInfo Catalan = CultureInfo.GetCultureInfo("ca-ES");

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    private List<Ingredient> _knownIngredients = [];
    private List<Recipe> _recipes = [];
    private List<IngredientIssue> _recipeIssues = [];
    private List<IngredientIssue> _plannedIssues = [];
    private DateOnly _selectedWeekStart;
    private string _mode = GapMode.Planned;
    private string _search = string.Empty;
    private bool _isLoading = true;

    private List<Ingredient> FilteredKnownMissingIngredients => _knownIngredients
        .Where(ingredient => IngredientNutritionRules.RequiresNutritionData(ingredient))
        .Where(ingredient => ingredient.NutritionPer100Grams?.HasAnyValue != true)
        .Where(MatchesSearch)
        .OrderBy(ingredient => ingredient.Name)
        .ToList();

    private List<IngredientIssue> FilteredPlannedIssues => _plannedIssues
        .Where(MatchesSearch)
        .OrderBy(issue => issue.Date)
        .ThenBy(issue => issue.MealKind)
        .ThenBy(issue => issue.RecipeName)
        .ThenBy(issue => issue.DisplayName)
        .ToList();

    private List<IngredientIssueGroup> FilteredUnresolvedGroups => _recipeIssues
        .Where(issue => issue.Kind == IssueKind.Unresolved)
        .GroupBy(IssueGroupKey, StringComparer.OrdinalIgnoreCase)
        .Select(group => new IngredientIssueGroup(
            group.Key,
            group.First().DisplayName,
            group.OrderBy(issue => issue.RecipeName).ToList()))
        .Where(MatchesSearch)
        .OrderBy(group => group.DisplayName)
        .ToList();

    private List<IngredientIssue> FilteredQuantityIssues => _recipeIssues
        .Where(issue => issue.Kind == IssueKind.Quantity)
        .Where(MatchesSearch)
        .OrderBy(issue => issue.RecipeName)
        .ThenBy(issue => issue.DisplayName)
        .ToList();

    private Color MissingNutritionColor => FilteredKnownMissingIngredients.Count == 0 ? Color.Success : Color.Warning;
    private Color UnresolvedColor => FilteredUnresolvedGroups.Count == 0 ? Color.Success : Color.Warning;
    private Color QuantityColor => FilteredQuantityIssues.Count == 0 ? Color.Success : Color.Warning;
    private string SelectedWeekRangeText => $"{_selectedWeekStart.ToString("d/M", CultureInfo.InvariantCulture)} - {_selectedWeekStart.AddDays(6).ToString("d/M/yyyy", CultureInfo.InvariantCulture)}";
    private bool IsCurrentWeekSelected => _selectedWeekStart == PlannerService.WeekStart(DateOnly.FromDateTime(DateTime.Today));

    protected override void OnParametersSet()
    {
        _mode = NormalizeMode(View);
    }

    protected override async Task OnInitializedAsync()
    {
        _selectedWeekStart = PlannerService.WeekStart(DateOnly.FromDateTime(DateTime.Today));
        await LoadAsync();
        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        if (_selectedWeekStart == default)
        {
            _selectedWeekStart = PlannerService.WeekStart(DateOnly.FromDateTime(DateTime.Today));
        }

        _knownIngredients = await IngredientKnowledge.GetKnownIngredientsAsync();
        _recipes = await Recipes.GetAllAsync();
        _recipeIssues = BuildRecipeIssues(_recipes);

        var days = await Planner.GetWeekAsync(_selectedWeekStart);
        _plannedIssues = BuildPlannedIssues(days);
    }

    private RenderFragment PlannedIssuesPanel() => @<MudPaper Class="gap-panel" Elevation="0">
        <div class="gap-week-heading">
            <div>
                <MudText Typo="Typo.h6">Setmana seleccionada</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@SelectedWeekRangeText</MudText>
            </div>
            <MudStack Row Class="gap-week-nav">
                <MudButton OnClick="PreviousWeekAsync"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ChevronLeft">
                    Anterior
                </MudButton>
                <MudButton OnClick="CurrentWeekAsync"
                           Disabled="@IsCurrentWeekSelected"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Today">
                    Actual
                </MudButton>
                <MudButton OnClick="NextWeekAsync"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.ChevronRight">
                    Seguent
                </MudButton>
            </MudStack>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Aixo explica els avisos que surten al planner per aquesta setmana del calendari.
        </MudText>
        @if (FilteredPlannedIssues.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">La setmana seleccionada no te buits de nutricio ni quantitat.</MudAlert>
        }
        else
        {
            <div class="gap-list">
                @foreach (var issue in FilteredPlannedIssues)
                {
                    @IssueRow(issue, showPlannedContext: true)
                }
            </div>
        }
    </MudPaper>;

    private RenderFragment KnownMissingNutritionPanel() => @<MudPaper Class="gap-panel" Elevation="0">
        <MudText Typo="Typo.h6">Ingredients coneguts sense nutricio</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Ingredients del cataleg local sense valors per 100 g. Pots informar-los manualment.
        </MudText>
        @if (FilteredKnownMissingIngredients.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">No queden ingredients coneguts sense nutricio amb aquest filtre.</MudAlert>
        }
        else
        {
            <div class="gap-list">
                @foreach (var ingredient in FilteredKnownMissingIngredients)
                {
                    <MudPaper Class="gap-row" Elevation="0">
                        <div class="gap-row-main">
                            <MudText Typo="Typo.subtitle1">@ingredient.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @DisplayCategory(ingredient.Category)
                                @if (!string.IsNullOrWhiteSpace(ingredient.Subcategory))
                                {
                                    <span> / @ingredient.Subcategory</span>
                                }
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Aliases: @AliasesText(ingredient)</MudText>
                        </div>
                        <div class="gap-row-actions">
                            <MudButton OnClick="@(() => OpenNutritionDialogAsync(ingredient))"
                                       Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Edit">
                                Informar nutricio
                            </MudButton>
                        </div>
                    </MudPaper>
                }
            </div>
        }
    </MudPaper>;

    private RenderFragment UnresolvedPanel() => @<MudPaper Class="gap-panel" Elevation="0">
        <MudText Typo="Typo.h6">Ingredients de recepta no vinculats</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Aquests ingredients encara no apunten a cap ingredient conegut. Cal entrar a la recepta i vincular-los.
        </MudText>
        @if (FilteredUnresolvedGroups.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">No hi ha ingredients unresolved amb aquest filtre.</MudAlert>
        }
        else
        {
            <div class="gap-list">
                @foreach (var group in FilteredUnresolvedGroups)
                {
                    <MudPaper Class="gap-row" Elevation="0">
                        <div class="gap-row-main">
                            <div class="gap-row-title">
                                <MudText Typo="Typo.subtitle1">@group.DisplayName</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                    @group.Issues.Count usos
                                </MudChip>
                            </div>
                            <div class="gap-occurrences">
                                @foreach (var issue in group.Issues.Take(6))
                                {
                                    <div class="gap-occurrence">
                                        <MudLink Href="@RecipeEditHref(issue)">@issue.RecipeName</MudLink>
                                        <span>@issue.IngredientText</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="gap-row-actions">
                            <MudButton Href="@RecipeEditHref(group.Issues[0])"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Link">
                                Vincular
                            </MudButton>
                        </div>
                    </MudPaper>
                }
            </div>
        }
    </MudPaper>;

    private RenderFragment QuantityPanel() => @<MudPaper Class="gap-panel" Elevation="0">
        <MudText Typo="Typo.h6">Quantitats no utilitzables</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            La nutricio existeix, pero la quantitat/unitat no es pot convertir a grams.
        </MudText>
        @if (FilteredQuantityIssues.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">No hi ha problemes de quantitat amb aquest filtre.</MudAlert>
        }
        else
        {
            <div class="gap-list">
                @foreach (var issue in FilteredQuantityIssues)
                {
                    @IssueRow(issue, showPlannedContext: false)
                }
            </div>
        }
    </MudPaper>;

    private RenderFragment IssueRow(IngredientIssue issue, bool showPlannedContext) => @<MudPaper Class="gap-row" Elevation="0">
        <div class="gap-row-main">
            <div class="gap-row-title">
                <MudText Typo="Typo.subtitle1">@issue.DisplayName</MudText>
                <MudChip T="string" Size="Size.Small" Color="@IssueColor(issue)" Variant="Variant.Outlined">
                    @IssueLabel(issue)
                </MudChip>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@issue.IngredientText</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @if (showPlannedContext && issue.Date is not null && issue.MealKind is not null)
                {
                    <span>@issue.Date.Value.ToString("ddd d/M", Catalan) / @issue.MealKind.Value.ToDisplayName() / </span>
                }
                <MudLink Href="@RecipeEditHref(issue)">@issue.RecipeName</MudLink>
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@IssueHelp(issue)</MudText>
        </div>
        <div class="gap-row-actions">
            @if (issue.Kind == IssueKind.MissingNutrition && issue.Ingredient is not null)
            {
                <MudButton OnClick="@(() => OpenNutritionDialogAsync(issue.Ingredient))"
                           Variant="Variant.Filled"
                           Color="Color.Warning"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit">
                    Informar nutricio
                </MudButton>
            }
            else
            {
                <MudButton Href="@RecipeEditHref(issue)"
                           Variant="Variant.Outlined"
                           Color="@IssueColor(issue)"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit">
                    Editar recepta
                </MudButton>
            }
        </div>
    </MudPaper>;

    private RenderFragment GapMetric(string label, int value, string unit, string mode, Color color) => @<MudPaper Class="@GapMetricClass(mode)" Elevation="0" @onclick="@(() => SetMode(mode))">
        <MudText Typo="Typo.overline">@label</MudText>
        <MudText Typo="Typo.h6" Color="@color">@value</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@unit</MudText>
    </MudPaper>;

    private RenderFragment ModeButton(string mode, string label, string icon, Color color) => @<MudButton OnClick="@(() => SetMode(mode))"
                                                                                                         Variant="@(_mode == mode ? Variant.Filled : Variant.Outlined)"
                                                                                                         Color="@color"
                                                                                                         Size="Size.Small"
                                                                                                         StartIcon="@icon">
        @label
    </MudButton>;

    private void SetMode(string mode)
    {
        _mode = NormalizeMode(mode);
    }

    private async Task PreviousWeekAsync()
    {
        _selectedWeekStart = _selectedWeekStart.AddDays(-7);
        await LoadAsync();
    }

    private async Task NextWeekAsync()
    {
        _selectedWeekStart = _selectedWeekStart.AddDays(7);
        await LoadAsync();
    }

    private async Task CurrentWeekAsync()
    {
        _selectedWeekStart = PlannerService.WeekStart(DateOnly.FromDateTime(DateTime.Today));
        await LoadAsync();
    }

    private async Task OpenNutritionDialogAsync(Ingredient ingredient)
    {
        var parameters = new DialogParameters<IngredientNutritionDialog>
        {
            { dialog => dialog.Ingredient, ingredient }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<IngredientNutritionDialog>($"Nutricio: {ingredient.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not IngredientNutritionManualEdit edit)
        {
            return;
        }

        var saved = await IngredientKnowledge.SaveNutritionAsync(ingredient.KnowledgeId, edit);
        if (!saved)
        {
            Snackbar.Add("No s'ha pogut desar la nutricio.", Severity.Error);
            return;
        }

        await LoadAsync();
        Snackbar.Add("Nutricio desada.", Severity.Success);
    }

    private static List<IngredientIssue> BuildRecipeIssues(IEnumerable<Recipe> recipes)
    {
        var issues = new List<IngredientIssue>();
        foreach (var recipe in recipes.OrderBy(recipe => recipe.Name))
        {
            foreach (var ingredient in recipe.Ingredients.OrderBy(ingredient => ingredient.Order))
            {
                if (BuildIssue(recipe, ingredient, scale: 1m, null, null) is { } issue)
                {
                    issues.Add(issue);
                }
            }
        }

        return issues;
    }

    private static List<IngredientIssue> BuildPlannedIssues(IEnumerable<DayPlan> days)
    {
        var issues = new List<IngredientIssue>();
        foreach (var day in days)
        {
            foreach (var slot in new[] { day.Breakfast, day.Lunch, day.Dinner })
            {
                foreach (var plannedRecipe in slot.PlannedRecipes.OrderBy(recipe => recipe.Order))
                {
                    var recipe = plannedRecipe.Recipe;
                    if (recipe is null)
                    {
                        continue;
                    }

                    var scale = IngredientScaling.ScaleFactor(recipe.Servings, plannedRecipe.PlannedServings);
                    foreach (var ingredient in recipe.Ingredients.OrderBy(ingredient => ingredient.Order))
                    {
                        if (BuildIssue(recipe, ingredient, scale, day.Date, slot.MealKind) is { } issue)
                        {
                            issues.Add(issue);
                        }
                    }
                }
            }
        }

        return issues;
    }

    private static IngredientIssue? BuildIssue(
        Recipe recipe,
        RecipeIngredient recipeIngredient,
        decimal scale,
        DateOnly? date,
        MealKind? mealKind)
    {
        var linkedIngredient = recipeIngredient.Ingredient;
        var displayName = linkedIngredient?.Name ?? recipeIngredient.Name;
        var ingredientText = recipeIngredient.ToDisplayText(scale);

        if (linkedIngredient is null || string.IsNullOrWhiteSpace(linkedIngredient.KnowledgeId))
        {
            return new IngredientIssue(IssueKind.Unresolved, displayName, ingredientText, null, recipe.Id, recipe.Name, date, mealKind);
        }

        if (IngredientNutritionRules.ShouldIgnoreForNutrition(linkedIngredient))
        {
            return null;
        }

        if (IngredientNutritionRules.IsSalt(linkedIngredient))
        {
            return QuantityInGrams(recipeIngredient, scale) is null
                ? new IngredientIssue(IssueKind.Quantity, linkedIngredient.Name, ingredientText, linkedIngredient, recipe.Id, recipe.Name, date, mealKind)
                : null;
        }

        if (linkedIngredient.NutritionPer100Grams?.HasAnyValue != true)
        {
            return new IngredientIssue(IssueKind.MissingNutrition, linkedIngredient.Name, ingredientText, linkedIngredient, recipe.Id, recipe.Name, date, mealKind);
        }

        if (QuantityInGrams(recipeIngredient, scale) is null)
        {
            return new IngredientIssue(IssueKind.Quantity, linkedIngredient.Name, ingredientText, linkedIngredient, recipe.Id, recipe.Name, date, mealKind);
        }

        return null;
    }

    private static decimal? QuantityInGrams(RecipeIngredient ingredient, decimal scale) =>
        IngredientQuantityConverter.ToGrams(ingredient, scale);

    private bool MatchesSearch(Ingredient ingredient) =>
        string.IsNullOrWhiteSpace(_search)
        || ingredient.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || ingredient.CatalanName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || ingredient.SpanishName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || ingredient.Aliases.Any(alias => alias.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private bool MatchesSearch(IngredientIssue issue) =>
        string.IsNullOrWhiteSpace(_search)
        || issue.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || issue.IngredientText.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || issue.RecipeName.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private bool MatchesSearch(IngredientIssueGroup group) =>
        string.IsNullOrWhiteSpace(_search)
        || group.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || group.Issues.Any(MatchesSearch);

    private static string IssueGroupKey(IngredientIssue issue) =>
        issue.Ingredient?.KnowledgeId is { Length: > 0 } knowledgeId
            ? $"known:{knowledgeId}"
            : $"raw:{FoodText.Normalize(issue.DisplayName)}";

    private static string NormalizeMode(string? mode) => mode?.Trim().ToLowerInvariant() switch
    {
        "missing" or "missing-nutrition" or "nutrition" => GapMode.MissingNutrition,
        "unresolved" => GapMode.Unresolved,
        "quantity" or "quantities" => GapMode.Quantity,
        _ => GapMode.Planned
    };

    private string GapMetricClass(string mode) =>
        _mode == mode ? "gap-metric is-active" : "gap-metric";

    private static string RecipeEditHref(IngredientIssue issue) =>
        $"recipes/{issue.RecipeId}/edit#ingredients";

    private static string IssueLabel(IngredientIssue issue) => issue.Kind switch
    {
        IssueKind.Unresolved => "Unresolved",
        IssueKind.Quantity => "Quantitat",
        _ => "Sense nutricio"
    };

    private static string IssueHelp(IngredientIssue issue) => issue.Kind switch
    {
        IssueKind.Unresolved => "Cal vincular-lo a un ingredient conegut.",
        IssueKind.Quantity => "Cal posar una quantitat i unitat usable, per exemple g, kg, ml, cullerada o unitat coneguda.",
        _ => "Cal informar valors nutricionals per 100 g."
    };

    private static Color IssueColor(IngredientIssue issue) => issue.Kind switch
    {
        IssueKind.Quantity => Color.Info,
        _ => Color.Warning
    };

    private static bool ContainsAny(string value, params string[] fragments) =>
        fragments.Any(fragment => value.Contains(fragment, StringComparison.OrdinalIgnoreCase));

    private static string AliasesText(Ingredient ingredient) =>
        ingredient.Aliases.Count == 0
            ? "Sense aliases"
            : string.Join(", ", ingredient.Aliases);

    private static string DisplayCategory(string category) => category switch
    {
        "fruit" => "Fruita",
        "vegetables" => "Verdures",
        "meat" => "Carn",
        "fish" => "Peix",
        "dairy-eggs" => "Lactis i ous",
        "legumes" => "Llegums",
        "grains" => "Cereals",
        "pantry" => "Rebost",
        "spices" => "Especies",
        IngredientCategory.Fruit => "Fruita",
        IngredientCategory.Vegetables => "Verdures",
        IngredientCategory.Meat => "Carn",
        IngredientCategory.Fish => "Peix",
        IngredientCategory.DairyEggs => "Lactis i ous",
        IngredientCategory.Legumes => "Llegums",
        IngredientCategory.Grains => "Cereals",
        IngredientCategory.Pantry => "Rebost",
        IngredientCategory.Spices => "Especies",
        _ => category
    };

    private static class GapMode
    {
        public const string Planned = "planned";
        public const string MissingNutrition = "missing";
        public const string Unresolved = "unresolved";
        public const string Quantity = "quantity";
    }

    private static class IssueKind
    {
        public const string MissingNutrition = "missing-nutrition";
        public const string Unresolved = "unresolved";
        public const string Quantity = "quantity";
    }

    private sealed record IngredientIssue(
        string Kind,
        string DisplayName,
        string IngredientText,
        Ingredient? Ingredient,
        int RecipeId,
        string RecipeName,
        DateOnly? Date,
        MealKind? MealKind);

    private sealed record IngredientIssueGroup(
        string Key,
        string DisplayName,
        IReadOnlyList<IngredientIssue> Issues);
}
