@page "/recipes"
@inject RecipeService Recipes
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Nasdanus - Receptes</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="page-shell">
    <MudStack Spacing="3">
        <div class="page-heading page-heading-actions">
            <div>
                <MudText Typo="Typo.overline">Receptes</MudText>
                <MudText Typo="Typo.h3">Receptari</MudText>
            </div>
            <MudButton OnClick="OpenQuickAddAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Add">
                Nova recepta
            </MudButton>
        </div>

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudPaper Class="recipe-dashboard" Elevation="0">
                <div class="recipe-dashboard-group">
                    @DashboardMetric("Recipes", Dashboard.TotalRecipes, "total")
                </div>
                <div class="recipe-dashboard-group">
                    @DashboardMetric("Documentation", Dashboard.CompleteRecipes, "Complete")
                    @DashboardMetric("Draft", Dashboard.DraftRecipes, "recipes")
                    @DashboardMetric("Empty", Dashboard.EmptyRecipes, "recipes")
                </div>
                <div class="recipe-dashboard-group">
                    @DashboardMetric("Cooking", Dashboard.TestedRecipes, "Tested")
                    @DashboardMetric("Family Approved", Dashboard.FamilyApprovedRecipes, "recipes")
                    @DashboardMetric("Favourite", Dashboard.FavouriteRecipes, "recipes")
                </div>
                <div class="recipe-dashboard-group">
                    @DashboardMetric("Knowledge", Dashboard.FullyLinkedRecipes, "fully linked")
                    @DashboardMetric("Partial", Dashboard.PartiallyLinkedRecipes, "linked")
                    @DashboardMetric("Unresolved", Dashboard.UnresolvedRecipes, "recipes")
                </div>
            </MudPaper>

            <MudPaper Class="filter-bar" Elevation="0">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="5">
                        <MudTextField T="string"
                                      @bind-Value="_search"
                                      Immediate="true"
                                      Placeholder="Cerca per nom, ingredient o tag"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string"
                                   @bind-Value="_category"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true"
                                   AdornmentIcon="@Icons.Material.Filled.Category"
                                   Adornment="Adornment.Start">
                            <MudSelectItem T="string" Value="@string.Empty">Totes les categories</MudSelectItem>
                            @foreach (var category in _categories)
                            {
                                <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="string"
                                   Label="Documentation"
                                   @bind-Value="_documentationStatus"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true">
                            <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
                            @foreach (var status in RecipeDocumentationStatus.All)
                            {
                                <MudSelectItem T="string" Value="@status">@RecipeDocumentationStatus.ToDisplayName(status)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="string"
                                   Label="Cooking"
                                   @bind-Value="_cookingStatus"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true">
                            <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
                            @foreach (var status in RecipeCookingStatus.All)
                            {
                                <MudSelectItem T="string" Value="@status">@RecipeCookingStatus.ToDisplayName(status)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <div class="recipe-filter-actions">
                    <MudButton OnClick="UseDefaultFilters" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Everyday planning</MudButton>
                    <MudButton OnClick="ViewAllRecipes" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">View all recipes</MudButton>
                    <MudButton OnClick="@(() => ShowDocumentation(RecipeDocumentationStatus.Empty))" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">Only empty</MudButton>
                    <MudButton OnClick="@(() => ShowDocumentation(RecipeDocumentationStatus.Draft))" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">Only draft</MudButton>
                    <MudButton OnClick="@(() => SetQuickFilter(RecipeLibraryFilter.WithoutNutrition))" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">Without nutrition</MudButton>
                    <MudButton OnClick="@(() => SetQuickFilter(RecipeLibraryFilter.UnresolvedIngredients))" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">Unresolved ingredients</MudButton>
                    <MudButton OnClick="@(() => ShowCooking(RecipeCookingStatus.NeverCooked))" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">Never cooked</MudButton>
                    <MudButton OnClick="@(() => ShowCooking(RecipeCookingStatus.FamilyApproved))" Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small">Family Approved</MudButton>
                </div>

                <div class="recipe-filter-chips" role="group" aria-label="Recipe quick filters">
                    @foreach (var filter in QuickFilters)
                    {
                        <MudButton OnClick="@(() => ToggleQuickFilter(filter.Key))"
                                   Variant="@QuickFilterVariant(filter.Key)"
                                   Color="Color.Primary"
                                   Size="Size.Small">
                            @filter.Label
                        </MudButton>
                    }
                </div>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FilteredRecipes.Count recipe(s). Search checks the full recipe library and ignores the default documentation/cooking filters.
                </MudText>
            </MudPaper>

            @if (FilteredRecipes.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No hi ha receptes amb aquests filtres.</MudAlert>
            }
            else
            {
                <div class="recipe-list">
                    @foreach (var recipe in FilteredRecipes)
                    {
                        <RecipeSummaryCard Recipe="recipe" OnConsolidate="ConsolidateAsync" />
                    }
                </div>
            }
        }
    </MudStack>
</MudContainer>

@code {
    private List<Recipe> _recipes = [];
    private List<string> _categories = [];
    private string _search = string.Empty;
    private string _category = string.Empty;
    private string _documentationStatus = RecipeDocumentationStatus.Complete;
    private string _cookingStatus = RecipeCookingStatus.FamilyApproved;
    private string _quickFilter = string.Empty;
    private bool _isLoading = true;

    private static readonly RecipeFilterChip[] QuickFilters =
    [
        new(RecipeLibraryFilter.Favourite, "Favourite"),
        new(RecipeLibraryFilter.Fish, "Fish"),
        new(RecipeLibraryFilter.Chicken, "Chicken"),
        new(RecipeLibraryFilter.Meat, "Meat"),
        new(RecipeLibraryFilter.Pasta, "Pasta"),
        new(RecipeLibraryFilter.Salad, "Salad"),
        new(RecipeLibraryFilter.Legumes, "Legumes"),
        new(RecipeLibraryFilter.Soup, "Soup"),
        new(RecipeLibraryFilter.Dessert, "Dessert"),
        new(RecipeLibraryFilter.HighProtein, "High protein"),
        new(RecipeLibraryFilter.QuickMeals, "Quick meals"),
        new(RecipeLibraryFilter.Seasonal, "Seasonal"),
        new(RecipeLibraryFilter.FreezerFriendly, "Freezer friendly"),
        new(RecipeLibraryFilter.BatchCooking, "Batch cooking"),
        new(RecipeLibraryFilter.Vegetarian, "Vegetarian")
    ];

    private bool IsSearchActive => !string.IsNullOrWhiteSpace(_search);
    private RecipeLibraryDashboard Dashboard => RecipeLibraryAnalysis.Dashboard(_recipes);
    private List<Recipe> FilteredRecipes => _recipes
        .Select(recipe => (Recipe: recipe, Profile: RecipeLibraryAnalysis.Analyze(recipe)))
        .Where(item => MatchesFilters(item.Recipe, item.Profile))
        .OrderBy(item => item.Profile.DocumentationStatus == RecipeDocumentationStatus.Empty ? 1 : 0)
        .ThenByDescending(item => item.Profile.CompletionPercent)
        .ThenBy(item => item.Recipe.Name)
        .Select(item => item.Recipe)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadRecipesAsync();
        _isLoading = false;
    }

    private bool MatchesFilters(Recipe recipe, RecipeLibraryProfile profile)
    {
        if (IsSearchActive && !RecipeLibraryAnalysis.MatchesSearch(recipe, _search))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_category)
            && !string.Equals(recipe.Category, _category, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_quickFilter)
            && !RecipeLibraryAnalysis.MatchesFilter(recipe, profile, _quickFilter))
        {
            return false;
        }

        if (IsSearchActive)
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(_documentationStatus)
            && profile.DocumentationStatus != _documentationStatus)
        {
            return false;
        }

        return string.IsNullOrWhiteSpace(_cookingStatus)
            || RecipeLibraryAnalysis.MatchesCookingStatus(profile, _cookingStatus);
    }

    private async Task OpenQuickAddAsync()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = await DialogService.ShowAsync<QuickAddRecipeDialog>("Nova recepta", options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadRecipesAsync();
        }
    }

    private async Task LoadRecipesAsync()
    {
        _recipes = await Recipes.GetAllAsync();
        _categories = await Recipes.GetCategoriesAsync();
    }

    private void UseDefaultFilters()
    {
        _search = string.Empty;
        _documentationStatus = RecipeDocumentationStatus.Complete;
        _cookingStatus = RecipeCookingStatus.FamilyApproved;
        _quickFilter = string.Empty;
    }

    private void ViewAllRecipes()
    {
        _documentationStatus = string.Empty;
        _cookingStatus = string.Empty;
        _quickFilter = string.Empty;
    }

    private void ShowDocumentation(string status)
    {
        _search = string.Empty;
        _documentationStatus = status;
        _cookingStatus = string.Empty;
        _quickFilter = string.Empty;
    }

    private void ShowCooking(string status)
    {
        _search = string.Empty;
        _documentationStatus = string.Empty;
        _cookingStatus = status;
        _quickFilter = string.Empty;
    }

    private void SetQuickFilter(string filter)
    {
        _quickFilter = filter;
        _documentationStatus = string.Empty;
        _cookingStatus = string.Empty;
    }

    private void ToggleQuickFilter(string filter)
    {
        _quickFilter = string.Equals(_quickFilter, filter, StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : filter;
    }

    private Variant QuickFilterVariant(string filter) =>
        string.Equals(_quickFilter, filter, StringComparison.OrdinalIgnoreCase)
            ? Variant.Filled
            : Variant.Outlined;

    private async Task ConsolidateAsync(Recipe recipe)
    {
        await Recipes.ConsolidateAsync(recipe.Id);
        await LoadRecipesAsync();
        Snackbar.Add("Recepta consolidada.", Severity.Success);
    }

    private static RenderFragment DashboardMetric(string label, int value, string suffix) => @<MudPaper Class="recipe-dashboard-metric" Elevation="0">
        <MudText Typo="Typo.overline">@label</MudText>
        <MudText Typo="Typo.h6">@value</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@suffix</MudText>
    </MudPaper>;

    private sealed record RecipeFilterChip(string Key, string Label);
}
